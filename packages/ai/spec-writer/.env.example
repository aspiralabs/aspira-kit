# Use the shared ../.env.local via a local symlink; never commit credentials.
# pnpm write loads ../.env.local and .env.development.local.
AI_GATEWAY_API_KEY=
# Writer phases (Claude by default).
SPEC_WRITER_EXPLORE_MODEL=anthropic/claude-opus-5.5
SPEC_WRITER_DRAFT_MODEL=anthropic/claude-opus-5.5
# Review phases: the same overrides spec-reviewer reads (Claude research, OpenAI specialists and reconciliation by default).
SPEC_REVIEW_FRONTIER_MODEL=anthropic/claude-opus-5.5
SPEC_REVIEW_SPECIALIST_MODEL=openai/gpt-6.1-sol
SPEC_REVIEW_RECONCILIATION_MODEL=openai/gpt-6.1-sol

# Optional JSON array of read-only MCP tools for the explore phase and the specialists.
# Same format as spec-reviewer/.env.example (Aspira UI and the Notion guidelines adapter).
MCP_READ_CONNECTIONS=

# Notion loader for the eve entry point when no guidelines snapshot is supplied:
NOTION_TOKEN=
KNOWLEDGE_PAGE=
