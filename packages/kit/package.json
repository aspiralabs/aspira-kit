{
  "name": "@aspiralabs/kit",
  "version": "0.8.12",
  "description": "The Aspira Labs kit CLI. `kit init --stack next` wires a project to @aspiralabs/ui, @aspiralabs/config and the @aspiralabs/agents skills; `kit add auth` writes a base Better Auth setup; `kit doctor` reports drift; `kit next` names a ticket's next step, `kit worktree` gives a ticket its own worktree and `kit cleanup` removes the folders and worktrees of finished tickets, each with an /aspira-* skill.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "templates",
    "hooks",
    "skills",
    "README.md"
  ],
  "bin": {
    "kit": "./dist/cli.js"
  },
  "exports": {
    "./playbook": {
      "types": "./dist/playbook.d.ts",
      "default": "./dist/playbook.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@aspiralabs/agent-common": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@aspiralabs/config": "workspace:*",
    "@types/node": "^22",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aspiralabs/aspira-kit.git",
    "directory": "packages/kit"
  },
  "homepage": "https://github.com/aspiralabs/aspira-kit/tree/main/packages/kit",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
