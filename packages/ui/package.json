{
  "name": "@aspiralabs/ui",
  "version": "0.0.0",
  "description": "Aspira Labs component library: components, tokens, component docs, and an MCP server that serves the docs to agents.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "tokens.css",
    "docs",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./tokens.css",
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./docs/*": "./docs/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "aspiralabs-ui-mcp": "./bin/mcp.js"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "mcp": "node bin/mcp.js",
    "migrate": "node scripts/migrate-component.mjs"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@ebay/nice-modal-react": "^1.2.13",
    "@hookform/resolvers": "^5.0.1",
    "@maskito/kit": "^3.7.0",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@radix-ui/react-avatar": "^1.1.7",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.12",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-portal": "^1.1.9",
    "@radix-ui/react-scroll-area": "^1.2.4",
    "@radix-ui/react-select": "^2.1.7",
    "@radix-ui/react-slider": "^1.3.5",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-switch": "^1.2.2",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tanstack/react-query": "^5.74.11",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.13.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dayjs": "^1.11.13",
    "framer-motion": "^12.7.3",
    "imask": "^7.6.1",
    "input-otp": "^1.4.2",
    "react-colorful": "^5.6.1",
    "react-day-picker": "^9.14.0",
    "react-hook-form": "^7.55.0",
    "react-imask": "7.6.1",
    "sonner": "^2.0.3",
    "tailwind-merge": "^3.3.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@aspiralabs/config": "workspace:*",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.0",
    "react": "^19",
    "react-dom": "^19",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/aspiralabs/aspira-kit.git",
    "directory": "packages/ui"
  },
  "homepage": "https://github.com/aspiralabs/aspira-kit/tree/main/packages/ui",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
