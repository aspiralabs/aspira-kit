{
  "name": "@aspiralabs/config",
  "version": "0.1.0",
  "description": "Aspira Labs shared config: eslint, tsconfig, prettier, and agent config, as subpath exports.",
  "type": "module",
  "license": "MIT",
  "files": ["eslint", "tsconfig", "prettier", "agent", "README.md"],
  "exports": {
    "./eslint/base": "./eslint/base.js",
    "./eslint/next": "./eslint/next.js",
    "./eslint/library": "./eslint/library.js",
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./tsconfig/next.json": "./tsconfig/next.json",
    "./tsconfig/library.json": "./tsconfig/library.json",
    "./prettier": "./prettier/index.js",
    "./agent/*": "./agent/*"
  },
  "scripts": {
    "build": "echo '@aspiralabs/config has no build step'",
    "typecheck": "echo '@aspiralabs/config has no typecheck step'",
    "lint": "eslint eslint/"
  },
  "peerDependencies": {
    "eslint": "^9",
    "typescript": "^5"
  },
  "dependencies": {
    "@eslint/js": "^9.39.0",
    "eslint-config-next": "^16",
    "eslint-plugin-unicorn": "^62",
    "typescript-eslint": "^8.55.0",
    "globals": "^16"
  },
  "devDependencies": {
    "eslint": "^9.39.0"
  }
}
