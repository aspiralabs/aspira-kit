# Use the shared ../.env.local via a local symlink; never commit credentials.
# pnpm groom loads ../.env.local and .env.development.local.
AI_GATEWAY_API_KEY=
# Rounds (Claude Opus by default). Fact-finding runs on the fact-finder subagent's model, anthropic/claude-haiku-4.5.
GROOMER_ROUND_MODEL=anthropic/claude-opus-5.5

# Optional JSON array of read-only MCP tools for round zero and the round model.
# Same format as spec-reviewer/.env.example (Aspira UI and the Notion guidelines adapter).
MCP_READ_CONNECTIONS=

# Notion: the launcher's ticket step (board reads and writes) and the load-knowledge loader.
NOTION_TOKEN=
KNOWLEDGE_PAGE=
