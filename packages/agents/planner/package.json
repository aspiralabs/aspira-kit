{
  "name": "@aspiralabs/planner",
  "version": "0.5.3",
  "description": "Turn business specs into grounded, test-first implementation plans.",
  "type": "module",
  "scripts": {
    "dev": "eve dev",
    "build": "eve info",
    "info": "eve info",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint agent scripts",
    "mcp:check": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env.development.local --experimental-strip-types scripts/probe-mcp.ts",
    "plan": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env.development.local --experimental-strip-types scripts/plan.ts",
    "plan:local": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env.development.local --experimental-strip-types scripts/local.ts"
  },
  "dependencies": {
    "@aspiralabs/agent-common": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "^7.0.105",
    "amaro": "^1.2.1",
    "eve": "^0.63.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@aspiralabs/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "files": [
    "agent",
    "skill",
    "scripts",
    "README.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aspiralabs/aspira-kit.git",
    "directory": "packages/agents/planner"
  },
  "homepage": "https://github.com/aspiralabs/aspira-kit/tree/main/packages/agents/planner",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
