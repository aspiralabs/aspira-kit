{
  "name": "@aspiralabs/agent-common",
  "version": "0.5.2",
  "description": "Tools and helpers shared by the Aspira Labs eve agents: each agent re-exports what it mounts from agent/tools/.",
  "type": "module",
  "license": "MIT",
  "exports": {
    "./tools/*": "./src/tools/*.ts",
    "./lib/*": "./src/lib/*.ts"
  },
  "scripts": {
    "build": "echo '@aspiralabs/agent-common is source-only; the agents bundle it'",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "^7.0.105",
    "eve": "^0.63.0",
    "undici": "^7.29.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@aspiralabs/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "src",
    "scripts",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aspiralabs/aspira-kit.git",
    "directory": "packages/agents/common"
  },
  "homepage": "https://github.com/aspiralabs/aspira-kit/tree/main/packages/agents/common",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
