{
  "name": "@aspiralabs/spec-writer",
  "version": "0.2.1",
  "description": "Spec writer: repository exploration, an initial draft, then the official spec review.",
  "type": "module",
  "scripts": {
    "dev": "eve dev",
    "build": "eve info",
    "info": "eve info",
    "write": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env.development.local --experimental-strip-types scripts/write.ts",
    "write:local": "node --experimental-strip-types scripts/local.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint agent scripts"
  },
  "dependencies": {
    "@aspiralabs/agent-common": "workspace:*",
    "@aspiralabs/spec-reviewer": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "^7.0.105",
    "amaro": "^1.2.1",
    "eve": "^0.63.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@aspiralabs/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "files": [
    "agent",
    "skill",
    "scripts",
    "README.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aspiralabs/aspira-kit.git",
    "directory": "packages/agents/spec-writer"
  },
  "homepage": "https://github.com/aspiralabs/aspira-kit/tree/main/packages/agents/spec-writer",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
