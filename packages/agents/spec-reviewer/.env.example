# Use the shared ../.env.local via a local symlink; never commit credentials.
# pnpm review and pnpm mcp:check load ../.env.local and .env.development.local.
AI_GATEWAY_API_KEY=
SPEC_REVIEW_FRONTIER_MODEL=anthropic/claude-opus-5.5
SPEC_REVIEW_SPECIALIST_MODEL=openai/gpt-6-sol
SPEC_REVIEW_RECONCILIATION_MODEL=openai/gpt-6-sol

# Optional JSON array. Only explicitly listed READ tools are exposed to specialist contexts.
# HTTP bearer tokens are looked up by tokenEnv. OAuth must be provisioned externally;
# a Codex Notion login is not automatically shared with this agent.
# MCP_READ_CONNECTIONS=[{"name":"knowledge","url":"https://your-server/mcp","tokenEnv":"KNOWLEDGE_MCP_TOKEN","tools":["search","fetch"]}]
# Local Aspira UI (absolute installed path, node or another explicit executable):
# MCP_READ_CONNECTIONS=[{"name":"aspira_ui","command":"node","args":["/absolute/path/to/@aspiralabs/ui/bin/mcp.js"],"tools":["list_components","get_component","search","get_tokens","get_pattern"]}]
# Combined UI + included Notion adapter (adjust both absolute paths):
# MCP_READ_CONNECTIONS=[{"name":"aspira_ui","command":"node","args":["/absolute/ASPIRA_KIT/packages/ui/bin/mcp.js"],"tools":["list_components","get_component","search","get_tokens","get_pattern"]},{"name":"notion","command":"node","args":["--experimental-strip-types","/absolute/ASPIRA_KIT/packages/agents/spec-reviewer/scripts/notion-mcp.ts"],"envVars":["NOTION_TOKEN","KNOWLEDGE_PAGE"],"tools":["list_guidelines","read_guideline"]}]
MCP_READ_CONNECTIONS=

# Notion read-only MCP adapter and snapshot loader:
NOTION_TOKEN=
KNOWLEDGE_PAGE=
# Leave KNOWLEDGE_REQUIRED unset to use Agent Instructions + Review Verification.
