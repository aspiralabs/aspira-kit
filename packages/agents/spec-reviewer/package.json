{
  "name": "@aspiralabs/spec-reviewer",
  "version": "0.2.1",
  "private": true,
  "description": "Spec review: research, concurrent audits, deterministic reconciliation checks.",
  "type": "module",
  "exports": {
    "./lib/*": "./agent/lib/*.ts"
  },
  "scripts": {
    "dev": "eve dev",
    "build": "eve info",
    "info": "eve info",
    "review": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env.development.local --experimental-strip-types scripts/review.ts",
    "review:local": "node --experimental-strip-types scripts/local.ts",
    "score": "node --experimental-strip-types scripts/score.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint agent scripts",
    "mcp:check": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env.development.local --experimental-strip-types scripts/probe-mcp.ts"
  },
  "dependencies": {
    "@aspiralabs/agent-common": "workspace:*",
    "@modelcontextprotocol/sdk": "1.30.0",
    "ai": "^7.0.105",
    "eve": "^0.63.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@aspiralabs/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
