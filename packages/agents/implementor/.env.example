# Secrets live in the shared packages/agents/.env.local; this agent's .env.local is a symlink to it.
AI_GATEWAY_API_KEY=
# The orchestrator and its parallel worker copies. Default below.
IMPLEMENTOR_MODEL=anthropic/claude-opus-5.5
# Clone private repositories, push the implement/ branch and open the draft pull request.
GITHUB_TOKEN=
# Notion engineering rules for load-knowledge (shared with the other agents).
NOTION_TOKEN=
KNOWLEDGE_PAGE=
# Leave KNOWLEDGE_REQUIRED unset to use Agent Instructions + Review Verification.
