{
  "name": "@aspiralabs/pr-reviewer",
  "version": "0.5.0",
  "description": "pr-reviewer on eve: six specialist seats review a PR and argue, an independent verifier rules on every finding, and the loop runs until the fix list settles.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "eve dev",
    "build": "echo '@aspiralabs/pr-reviewer is not published; run `pnpm dev` to start the agent'",
    "review:local": "node --experimental-strip-types scripts/local.ts",
    "review:estimate": "node --experimental-strip-types scripts/estimate.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint agent scripts",
    "info": "eve info"
  },
  "dependencies": {
    "@aspiralabs/agent-common": "workspace:*",
    "@vercel/connect": "2.2.0",
    "ai": "^7.0.105",
    "amaro": "^1.2.1",
    "eve": "^0.63.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@aspiralabs/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "agent",
    "skill",
    "scripts",
    "README.md",
    ".env.example"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/aspiralabs/aspira-kit.git",
    "directory": "packages/agents/pr-reviewer"
  },
  "homepage": "https://github.com/aspiralabs/aspira-kit/tree/main/packages/agents/pr-reviewer",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
