+import { type RefObject, useEffect } from 'react';
+import type { CursorList } from '@/lib/api/api-fetcher';
+
+/** Options for {@link useCursorSentinel}. */
+export interface CursorSentinelOptions {
+    /** The list from `useCursorFetcher`. */
+    list: Pick<
+        CursorList<unknown>,
+        'hasNextPage' | 'isLoading' | 'isFetchingNextPage' | 'error' | 'nextPageError' | 'isExhausted' | 'fetchNextPage'
+    >;
+    /** The element that actually scrolls the list; null observes against the viewport. */
+    root: Element | null;
+    /** An element after the last row, outside any link or row. */
+    sentinelRef: RefObject<Element | null>;
+}
+
+/**
+ * Loads the next page of a cursor list while its sentinel is visible inside
+ * the scroll root. The sentinel stays observed for as long as it is mounted;
+ * whether a page may be requested is checked when it intersects. The observer
+ * is rebuilt whenever that answer changes (for example after each append), so
+ * an underfilled container keeps loading one page at a time until it fills or
+ * the list is exhausted. It never requests while a page is pending, and never
+ * retries a failure on its own: the user retries through `list.retry`.
+ * @param options - The list, its scroll root and the sentinel ref
+ */
+export function useCursorSentinel({ list, root, sentinelRef }: CursorSentinelOptions): void {
+    const { hasNextPage, isLoading, isFetchingNextPage, error, nextPageError, isExhausted, fetchNextPage } = list;
+    const canRequest = hasNextPage && !isLoading && !isFetchingNextPage && !error && !nextPageError && !isExhausted;
+
+    // Syncs with the browser's IntersectionObserver; reconnecting after each page re-checks visibility.
+    useEffect(() => {
+        const sentinel = sentinelRef.current;
+        if (!sentinel || typeof IntersectionObserver === 'undefined') return;
+        const observer = new IntersectionObserver(
+            (entries) => {
+                if (canRequest && entries.some((entry) => entry.isIntersecting)) fetchNextPage();
+            },
+            { root },
+        );
+        observer.observe(sentinel);
+        return () => observer.disconnect();
+    }, [canRequest, fetchNextPage, root, sentinelRef]);
+}
