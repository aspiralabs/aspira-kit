@@ -0,0 +1,203 @@
+// Shared harness for the NOM-4 mobile pagination and access tests
+// (docs/working-feature/nom-4-explore-pagination). Not a test file: jest only
+// collects *.test.ts(x).
+//
+// Mobile tests stub global fetch and run the real lib/api.ts client (author
+// decision 2026-10-02: no MSW on mobile), so these tests exercise the wire
+// contract the screens send and the Zod validation of searchPage.
+import { expect, jest } from '@jest/globals';
+import { useSyncExternalStore } from 'react';
+import { waitFor } from '@testing-library/react-native';
+import type { RecipeSearchResult } from '../../lib/api';
+
+// ---------------------------------------------------------------------------
+// Fixtures
+// ---------------------------------------------------------------------------
+
+/** One row of a cursor page: the lightweight search shape plus prep/cook times. */
+export type SearchRow = RecipeSearchResult & { prepTime?: number | null; cookTime?: number | null };
+
+export type CursorPage = { items: SearchRow[]; nextCursor: string | null };
+
+export function row(id: string, title: string, extra: Partial<SearchRow> = {}): SearchRow {
+  return { id, title, image: null, rating: null, previewText: null, badge: null, cookbooks: [], ...extra };
+}
+
+/** A cursor page of rows titled as given, with ids `id-<title>`. */
+export function pageOf(titles: string[], nextCursor: string | null): CursorPage {
+  return { items: titles.map((t) => row(`id-${t}`, t)), nextCursor };
+}
+
+export type Viewer = { id: string; name: string; email: string; image: string | null; role: string };
+
+export function viewer(id: string, name: string): Viewer {
+  return { id, name, email: `${id}@example.com`, image: null, role: '' };
+}
+
+// ---------------------------------------------------------------------------
+// Route params (expo-router stand-in)
+// ---------------------------------------------------------------------------
+
+export type RouteParams = Record<string, string | undefined>;
+
+/**
+ * A tiny external store standing in for expo-router's route params, so
+ * `router.setParams({ sort })` re-renders `useLocalSearchParams()` readers the
+ * way the real router does.
+ */
+export function createRouteStore(initial: RouteParams = {}) {
+  let params: RouteParams = { ...initial };
+  const listeners = new Set<() => void>();
+  const notify = () => listeners.forEach((l) => l());
+  const subscribe = (listener: () => void) => {
+    listeners.add(listener);
+    return () => listeners.delete(listener);
+  };
+  const get = () => params;
+  const setParams = jest.fn((next: RouteParams) => {
+    params = { ...params, ...next };
+    notify();
+  });
+  const router = {
+    push: jest.fn(),
+    replace: jest.fn(),
+    back: jest.fn(),
+    navigate: jest.fn(),
+    setParams,
+  };
+  return {
+    router,
+    setParams,
+    /** Replaces the params wholesale (a fresh navigation to the route). */
+    reset(next: RouteParams) {
+      params = { ...next };
+      notify();
+    },
+    current: get,
+    useParams: () => useSyncExternalStore(subscribe, get, get),
+  };
+}
+
+// ---------------------------------------------------------------------------
+// fetch stub
+// ---------------------------------------------------------------------------
+
+export type StubRequest = {
+  url: string;
+  /** Path below /api/v1, without the query string (e.g. '/search'). */
+  path: string;
+  method: string;
+  query: Record<string, string>;
+  /** The parsed JSON body, if any. */
+  body: unknown;
+  signal: AbortSignal | undefined;
+  /** True once the request was answered, failed or aborted. */
+  settled: () => boolean;
+  respond: (body: unknown, status?: number) => void;
+  fail: (error: Error) => void;
+};
+
+type AutoResponse = { body: unknown; status?: number } | ((req: StubRequest) => { body: unknown; status?: number });
+
+function jsonResponse(body: unknown, status: number): Response {
+  return new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+}
+
+function abortError(): Error {
+  const err = new Error('The operation was aborted.');
+  err.name = 'AbortError';
+  return err;
+}
+
+function urlOf(input: RequestInfo | URL): string {
+  if (typeof input === 'string') return input;
+  if (input instanceof URL) return input.href;
+  return input.url;
+}
+
+/**
+ * Replaces global fetch. Requests to `/search` are held until the test
+ * answers them (deferred responses); every other request is answered from the
+ * route table (`'GET /cuisines'` style keys, matched on method + path) or gets
+ * a 404 so an unexpected call is visible. An aborted request rejects with an
+ * AbortError like real fetch, and later answers to it are ignored.
+ */
+export function installFetchStub() {
+  const requests: StubRequest[] = [];
+  const routes = new Map<string, AutoResponse>();
+
+  const spy = jest.spyOn(global, 'fetch').mockImplementation((input: RequestInfo | URL, init?: RequestInit) => {
+    const url = urlOf(input);
+    const parsed = new URL(url);
+    const method = init?.method ?? 'GET';
+    const path = parsed.pathname.replace(/^\/api\/v1/, '');
+    const signal = init?.signal ?? undefined;
+
+    return new Promise<Response>((resolve, reject) => {
+      let done = false;
+      const req: StubRequest = {
+        url,
+        path,
+        method,
+        query: Object.fromEntries(parsed.searchParams.entries()),
+        body: typeof init?.body === 'string' ? JSON.parse(init.body) : undefined,
+        signal,
+        settled: () => done,
+        respond: (body, status = 200) => {
+          if (done) return;
+          done = true;
+          resolve(jsonResponse(body, status));
+        },
+        fail: (error) => {
+          if (done) return;
+          done = true;
+          reject(error);
+        },
+      };
+      requests.push(req);
+      if (signal?.aborted) {
+        req.fail(abortError());
+        return;
+      }
+      signal?.addEventListener('abort', () => req.fail(abortError()));
+
+      if (path === '/search') return; // held for the test to answer
+      const auto = routes.get(`${method} ${path}`);
+      if (!auto) {
+        req.respond({ error: `not stubbed: ${method} ${path}` }, 404);
+        return;
+      }
+      const answer = typeof auto === 'function' ? auto(req) : auto;
+      req.respond(answer.body, answer.status ?? 200);
+    });
+  });
+
+  const searches = (match: (q: Record<string, string>) => boolean = () => true) =>
+    requests.filter((r) => r.path === '/search' && match(r.query));
+
+  return {
+    spy,
+    requests,
+    /** Auto-answers `${method} ${path}` (path below /api/v1, no query string). */
+    route(key: string, response: AutoResponse) {
+      routes.set(key, response);
+    },
+    searches,
+    count(key: string) {
+      return requests.filter((r) => `${r.method} ${r.path}` === key).length;
+    },
+    /** Waits until the n-th (1-based) matching /search request exists and returns it. */
+    async nthSearch(n: number, match?: (q: Record<string, string>) => boolean): Promise<StubRequest> {
+      let found: StubRequest | undefined;
+      await waitFor(() => {
+        const list = searches(match);
+        expect(list.length).toBeGreaterThanOrEqual(n);
+        found = list[n - 1];
+      });
+      if (!found) throw new Error(`no search request #${n}`);
+      return found;
+    },
+  };
+}
+
+export type FetchStub = ReturnType<typeof installFetchStub>;
