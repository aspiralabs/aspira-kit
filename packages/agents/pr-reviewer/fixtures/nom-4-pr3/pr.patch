+const push = vi.hoisted(() => vi.fn());
+vi.mock('next/navigation', () => ({
+    useRouter: () => ({ push, replace: push, refresh: vi.fn(), back: vi.fn(), prefetch: vi.fn() }),
+    useSearchParams: () => new URLSearchParams(window.location.search),
+    usePathname: () => window.location.pathname,
+}));
+
+type SessionState = { data: { user: { id: string; role: string } } | null; isPending: boolean };
+const session = vi.hoisted((): { current: SessionState } => ({ current: { data: null, isPending: false } }));
+vi.mock('@/lib/auth/auth.client', () => ({ useSession: () => session.current }));
+const signedIn = (id: string): SessionState => ({ data: { user: { id, role: 'USER' } }, isPending: false });
+
+// ---------------------------------------------------------------------------
+// IntersectionObserver double: observe() reports the current state once, like
+// the browser; setSentinelVisible() reports a change to every live observer.
+// ---------------------------------------------------------------------------
+type ObserverRecord = {
+    callback: IntersectionObserverCallback;
+    targets: Set<Element>;
+    observer: FakeIntersectionObserver;
+};
+let observers: ObserverRecord[] = [];
+let isSentinelVisible = false;
+
+function report(record: ObserverRecord, target: Element) {
+    if (!record.targets.has(target)) return;
+    const rect = target.getBoundingClientRect();
+    record.callback(
+        [
+            {
+                boundingClientRect: rect,
+                intersectionRatio: isSentinelVisible ? 1 : 0,
+                intersectionRect: rect,
+                isIntersecting: isSentinelVisible,
+                rootBounds: null,
+                target,
+                time: Date.now(),
+            },
+        ],
+        record.observer,
+    );
+}
+
+class FakeIntersectionObserver {
+    readonly root: Element | Document | null;
+    readonly rootMargin = '0px';
+    readonly thresholds = [0];
+    private readonly record: ObserverRecord;
+
+    constructor(callback: IntersectionObserverCallback, options: IntersectionObserverInit = {}) {
+        this.root = options.root ?? null;
+        this.record = { callback, targets: new Set(), observer: this };
+        observers.push(this.record);
+    }
+
+    observe(target: Element) {
+        this.record.targets.add(target);
+        queueMicrotask(() => report(this.record, target));
+    }
+
+    unobserve(target: Element) {
+        this.record.targets.delete(target);
+    }
+
+    disconnect() {
+        this.record.targets.clear();
+    }
+
+    takeRecords(): IntersectionObserverEntry[] {
