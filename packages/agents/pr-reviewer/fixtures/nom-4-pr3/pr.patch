index 0000000..d75c3f2
--- /dev/null
+++ b/apps/web/lib/api/cursor.ts
@@ -0,0 +1,231 @@
+import { createHash } from 'node:crypto';
+
+import { z } from 'zod';
+
+import type { RecipeSearchSort } from '@/types/search';
+
+import { ApiError } from './response';
+
+// =============================================================================
+// Cursor pagination primitives (NOM-4)
+// =============================================================================
+// Opaque keyset cursors for /api/v1/search (paginated=1) and
+// /api/v1/users/:id/cookbooks. A cursor is base64url JSON:
+//   { version, keys, scope }
+//   - keys:  every value the sort compares, plus the id tie-break
+//   - scope: a hash of the normalized request context (endpoint, query,
+//            filters, sort, mode, viewer, profile/visibility scope)
+// A cursor is continuation state, never authorization: handlers recompute the
+// context from the current session on every request and reapply every access
+// predicate. A cursor minted under another context is a 400.
+
+/** Page size when `limit` is absent, nonnumeric or below one. */
+export const DEFAULT_CURSOR_LIMIT = 24;
+/** Largest page size; larger `limit` values clamp to this. */
+export const MAX_CURSOR_LIMIT = 48;
+/** Longest raw cursor string accepted before parsing. */
+export const MAX_CURSOR_LENGTH = 1024;
+
+const cursorVersion = 1;
+const invalidCursorMessage = 'Invalid cursor';
+
+/**
+ * Normalize a raw `limit` query param: absent, nonnumeric, nonfinite or
+ * below-one values use 24; values above 48 clamp to 48; fractions truncate.
+ */
+export function parseCursorLimit(raw: string | null | undefined): number {
+    if (raw === null || raw === undefined || raw.trim() === '') return DEFAULT_CURSOR_LIMIT;
+    const value = Number(raw);
+    if (!Number.isFinite(value) || value < 1) return DEFAULT_CURSOR_LIMIT;
+    return Math.min(Math.trunc(value), MAX_CURSOR_LIMIT);
+}
+
+// -----------------------------------------------------------------------------
+// Comparison values per sort
+// -----------------------------------------------------------------------------
+const idSchema = z.string().min(1).max(200);
+const isoDateSchema = z.iso.datetime();
+const finiteNumberSchema = z.number().refine(Number.isFinite);
+
+const relevanceKeysSchema = z.strictObject({ sort: z.literal('relevance'), score: finiteNumberSchema, id: idSchema });
+const newestKeysSchema = z.strictObject({ sort: z.literal('newest'), createdAt: isoDateSchema, id: idSchema });
+const topKeysSchema = z.strictObject({
+    sort: z.literal('top'),
+    rating: finiteNumberSchema,
+    ratingCount: z.number().int().nonnegative(),
+    id: idSchema,
+});
+// Missing-time rows (rank 1) carry no total; complete rows (rank 0) must.
+const timeKeysSchema = z.union([
+    z.strictObject({
+        sort: z.literal('time'),
+        missingRank: z.literal(0),
+        totalMinutes: z.number().int().nonnegative(),
+        id: idSchema,
+    }),
+    z.strictObject({ sort: z.literal('time'), missingRank: z.literal(1), totalMinutes: z.null(), id: idSchema }),
+]);
+const cookbookKeysSchema = z.strictObject({ sort: z.literal('cookbooks'), updatedAt: isoDateSchema, id: idSchema });
+
+/** Strict schema for a cursor's comparison values, one member per sort. */
+export const cursorKeysSchema = z.union([
+    relevanceKeysSchema,
+    newestKeysSchema,
+    topKeysSchema,
+    timeKeysSchema,
+    cookbookKeysSchema,
+]);
+
+export type CursorKeys = z.infer<typeof cursorKeysSchema>;
+export type CursorSort = CursorKeys['sort'];
+export type CursorKeysFor<S extends CursorSort> = Extract<CursorKeys, { sort: S }>;
+
+const cursorPayloadSchema = z.strictObject({
+    version: z.literal(cursorVersion),
+    keys: cursorKeysSchema,
+    scope: z.string().min(1).max(128),
+});
+
+// -----------------------------------------------------------------------------
+// Request contexts a cursor is bound to
+// -----------------------------------------------------------------------------
+export type SearchMode = 'public' | 'mine' | 'admin';
+
+/** Normalized /api/v1/search context. Build it with normalizeSearchCursorContext. */
+export interface SearchCursorContext {
+    endpoint: 'search';
+    q: string;
+    sort: RecipeSearchSort;
+    mode: SearchMode;
+    viewerId: string | null;
+    cuisineId: string | null;
+    course: string | null;
+    authorId: string | null;
+    isOnlyPublic: boolean;
+    isOnlyUserRecipes: boolean;
+    isFullMacros: boolean;
+    diet: string[];
+}
+
+export type SearchCursorContextInput = Omit<SearchCursorContext, 'endpoint'>;
+
+/** /api/v1/users/:id/cookbooks context: profile, viewer and visibility scope. */
+export interface CookbookCursorContext {
+    endpoint: 'cookbooks';
+    profileId: string;
+    viewerId: string | null;
+    scope: 'all' | 'public';
+}
+
+export type CursorContext = SearchCursorContext | CookbookCursorContext;
+
+/**
+ * Build a search context with a fixed shape: diet becomes a deduplicated,
+ * sorted set so equivalent filters bind to the same cursor scope.
+ */
+export function normalizeSearchCursorContext(input: SearchCursorContextInput): SearchCursorContext {
+    return {
+        endpoint: 'search',
+        q: input.q,
+        sort: input.sort,
+        mode: input.mode,
+        viewerId: input.viewerId,
+        cuisineId: input.cuisineId,
+        course: input.course,
+        authorId: input.authorId,
+        isOnlyPublic: input.isOnlyPublic,
+        isOnlyUserRecipes: input.isOnlyUserRecipes,
+        isFullMacros: input.isFullMacros,
+        diet: [...new Set(input.diet)].sort(),
+    };
+}
+
+// Hash the context with an explicit field order so equal contexts hash equally.
+function contextScope(context: CursorContext): string {
+    const ordered =
+        context.endpoint === 'search'
+            ? [
+                  context.endpoint,
+                  context.q,
+                  context.sort,
+                  context.mode,
+                  context.viewerId,
+                  context.cuisineId,
+                  context.course,
+                  context.authorId,
+                  context.isOnlyPublic,
+                  context.isOnlyUserRecipes,
+                  context.isFullMacros,
+                  [...new Set(context.diet)].sort(),
+              ]
+            : [context.endpoint, context.profileId, context.viewerId, context.scope];
+    return createHash('sha256').update(JSON.stringify(ordered)).digest('base64url');
+}
+
+// The sort a context expects its cursor keys to carry.
+function expectedSort(context: CursorContext): CursorSort {
+    return context.endpoint === 'search' ? context.sort : 'cookbooks';
+}
+
+function isKeysFor<S extends CursorSort>(keys: CursorKeys, sort: S): keys is CursorKeysFor<S> {
+    return keys.sort === sort;
+}
+
+/**
+ * Encode comparison values into an opaque cursor bound to `context`. Throws
+ * (500) if the values are invalid, so a bad row can never mint a cursor.
+ */
+export function encodeCursor(keys: CursorKeys, context: CursorContext): string {
+    const payload = cursorPayloadSchema.parse({
+        version: cursorVersion,
+        keys: cursorKeysSchema.parse(keys),
+        scope: contextScope(context),
+    });
+    return Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+}
+
+// Parse untrusted JSON without throwing.
+function parseJson(text: string): { ok: true; value: unknown } | { ok: false } {
+    try {
+        return { ok: true, value: JSON.parse(text) };
+    } catch {
+        return { ok: false };
+    }
+}
+
+/**
+ * Decode and validate an untrusted cursor against the current request context.
+ * Throws ApiError(400) for malformed, oversized, tampered or mismatched
+ * cursors (other query, sort, filters, mode, viewer, profile or scope).
+ */
+export function decodeCursor<S extends CursorSort>(raw: string, context: CursorContext, sort: S): CursorKeysFor<S> {
+    if (raw === '' || raw.length > MAX_CURSOR_LENGTH || !/^[A-Za-z0-9_-]+$/.test(raw)) {
+        throw new ApiError(invalidCursorMessage, 400);
+    }
+    const json = parseJson(Buffer.from(raw, 'base64url').toString('utf8'));
+    if (!json.ok) throw new ApiError(invalidCursorMessage, 400);
+    const parsed = cursorPayloadSchema.safeParse(json.value);
+    if (!parsed.success) throw new ApiError(invalidCursorMessage, 400);
+    const { keys, scope } = parsed.data;
+    if (scope !== contextScope(context) || sort !== expectedSort(context) || !isKeysFor(keys, sort)) {
+        throw new ApiError(invalidCursorMessage, 400);
+    }
+    return keys;
+}
+
+/**
+ * Turn a `limit + 1` lookahead fetch into a page: trims the lookahead row and
+ * mints `nextCursor` from the last returned row only when another row exists.
+ */
+export function buildCursorPage<T>(
+    rows: T[],
+    limit: number,
+    context: CursorContext,
+    keyOf: (row: T) => CursorKeys,
+): { items: T[]; nextCursor: string | null } {
+    if (rows.length <= limit) return { items: rows, nextCursor: null };
+    const items = rows.slice(0, limit);
+    const last = items.at(-1);
+    if (last === undefined) return { items, nextCursor: null };
+    return { items, nextCursor: encodeCursor(keyOf(last), context) };
+}
