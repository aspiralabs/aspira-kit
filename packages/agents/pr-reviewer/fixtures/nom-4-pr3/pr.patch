+// NOM-4 explore-pagination T10 (spec F8, F9): mobile Explore, the user
+// profile recipe list and both meal-plan picker tabs page /search with
+// opt-in cursor requests. Fetch is stubbed at the network boundary and the
+// real lib/api.ts client runs, so every assertion is about what the screen
+// sends and shows.
+//
+// UI contract these tests pin for the implementation lanes:
+// - initial failure: "Couldn't load recipes" plus a "Try again" button, never
+//   an empty state; later-page failure keeps rows and shows a "Try again"
+//   button; exhaustion text "No more recipes" only after a successful
+//   terminal page (nextCursor null).
+// - Explore sort chips are buttons named "Relevance", "Newest", "Top rated"
+//   and "Quickest" with accessibilityState.selected; the sort lives in the
+//   route params (`?sort=`), written with router.setParams({ sort }).
+import { beforeEach, describe, expect, it, jest } from '@jest/globals';
+import { act, fireEvent, screen, waitFor } from '@testing-library/react-native';
+import ExploreScreen from '../../app/(tabs)/explore';
+import UserProfileScreen from '../../app/user/[id]';
+import MealPlanScreen from '../../app/meal-plan';
+import { SESSION_KEY } from '../../hooks/useAuth';
+import { makeTestQueryClient, renderWithProviders } from '../../test-utils/render';
+import {
+  createRouteStore,
+  installFetchStub,
+  pageOf,
+  row,
+  viewer,
+  type FetchStub,
+  type RouteParams,
+} from '../helpers/search-harness';
+
+const mockRoute = createRouteStore();
+
+jest.mock('expo-router', () => {
+  const { useEffect } = jest.requireActual<typeof import('react')>('react');
+  return {
+    useLocalSearchParams: () => mockRoute.useParams(),
+    useGlobalSearchParams: () => mockRoute.useParams(),
+    useRouter: () => mockRoute.router,
+    get router() {
+      return mockRoute.router;
+    },
+    useFocusEffect: (effect: () => void) => useEffect(effect, [effect]),
+    Redirect: () => null,
+  };
+});
+jest.mock('../../lib/auth', () => ({
+  authClient: { getCookie: () => 'auth.session=abc' },
+  signOut: jest.fn(async () => undefined),
+  signIn: { email: jest.fn() },
+  getSession: jest.fn(),
+}));
+jest.mock('../../lib/session-store', () => ({
+  loadStoredUser: jest.fn(async () => null),
+  persistUser: jest.fn(async () => undefined),
+  clearStoredUser: jest.fn(async () => undefined),
+}));
+
+const VIEWER = viewer('user-a', 'Viewer A');
+const NO_MORE = 'No more recipes';
+const EMPTY_TEXT = /No recipes found|No public recipes yet/;
+
+let net: FetchStub;
+
+beforeEach(() => {
+  jest.spyOn(console, 'log').mockImplementation(() => undefined);
+  jest.spyOn(console, 'error').mockImplementation(() => undefined);
+  net = installFetchStub();
+  net.route('GET /cuisines', { body: [] });
+  net.route('GET /nutrition/stats/public', { body: { filterEnabled: false } });
+  net.route('GET /users/u2/profile', {
+    body: {
+      id: 'u2',
+      name: 'Cook Two',
+      username: 'cooktwo',
+      image: null,
+      bio: null,
+      followerCount: 0,
+      followingCount: 0,
+      _count: { recipes: 40, cookbooks: 0 },
+    },
+  });
+  net.route('GET /users/u2/block-status', { body: { isBlocking: false, isUnavailable: false } });
+  net.route('GET /users/u2/follow-status', { body: { isFollowing: false } });
+  net.route('GET /meal-plans', {
+    body: [
+      {
+        id: 'p1',
+        name: 'Plan One',
+        description: null,
+        isDefault: true,
+        createdAt: '2026-09-01T00:00:00.000Z',
+        updatedAt: '2026-09-01T00:00:00.000Z',
+        userId: VIEWER.id,
+      },
+    ],
+  });
+  net.route('GET /meal-plans/p1/meals', { body: [] });
+  net.route('POST /meal-plans/p1/meals', { body: { id: 'meal-1' } });
+});
+
+function signedInClient() {
+  const client = makeTestQueryClient();
+  client.setQueryData(SESSION_KEY, VIEWER);
+  return client;
+}
+
+async function mountExplore(params: RouteParams = {}) {
+  mockRoute.reset(params);
+  return renderWithProviders(<ExploreScreen />, signedInClient());
+}
+
+async function mountProfile() {
+  mockRoute.reset({ id: 'u2' });
+  const utils = await renderWithProviders(<UserProfileScreen />, signedInClient());
+  await screen.findByText('Cook Two');
+  return utils;
+}
+
+async function mountPicker(tab: 'My recipes' | 'Explore') {
+  mockRoute.reset({});
+  const utils = await renderWithProviders(<MealPlanScreen />, signedInClient());
+  await screen.findByText('Plan One');
