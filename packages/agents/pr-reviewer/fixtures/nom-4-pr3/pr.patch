index 0000000..8aca188
--- /dev/null
+++ b/apps/mobile/lib/search-access.ts
@@ -0,0 +1,71 @@
+import { notifyManager, type QueryClient } from '@tanstack/react-query';
+
+/**
+ * Root of every search-backed list key (Explore, profile by-author, planner picker).
+ * Each list key starts with this, followed by its surface and the viewer id
+ * (`user.id` or `'anonymous'`), so one prefix covers every cursor page.
+ */
+export const SEARCH_QUERY_KEY = ['search'] as const;
+
+// Recipe lists outside the cursor lists whose rows also depend on access.
+const RECIPES_QUERY_KEY = ['recipes'] as const;
+
+/** Why the search pages are being discarded. */
+export type SearchAccessChange =
+  /** Same viewer, different access (block, unblock): mounted lists restart at page one now. */
+  | 'access'
+  /**
+   * The viewer is about to change (login, verification, logout): pages are cleared
+   * and not refetched, so no request goes out under the old viewer. Lists start at
+   * page one when the new session is written and their viewer key changes.
+   */
+  | 'viewer';
+
+/**
+ * Discards every search-backed page after an access or viewer change.
+ *
+ * Cancels in-flight search requests first (aborting their fetches, so a late
+ * response from the old state can never be written), then clears the loaded
+ * pages so displayed rows disappear at once. For an `'access'` change mounted
+ * lists refetch from page one; for a `'viewer'` change nothing refetches until
+ * the new session is written and lists mount their new viewer key at page one. Access-dependent
+ * recipe lists are invalidated too. Resolves once mounted lists have been told
+ * the old pages are gone; it does not wait for the page-one refetch.
+ */
+export async function resetSearchAccess(
+  queryClient: QueryClient,
+  change: SearchAccessChange = 'access',
+): Promise<void> {
+  await queryClient.cancelQueries({ queryKey: SEARCH_QUERY_KEY });
+  if (change === 'access') {
+    // resetQueries clears the data synchronously; the returned refetch is not awaited.
+    void queryClient.resetQueries({ queryKey: SEARCH_QUERY_KEY });
+  } else {
+    // Clear every page without refetching: a refetch now would go out under the old
+    // viewer's key. Cleared queries hold no data, so whichever key a list mounts next
+    // (the new viewer's, or a viewer returned to later) starts again at page one.
+    const queries = queryClient.getQueryCache().findAll({ queryKey: SEARCH_QUERY_KEY });
+    notifyManager.batch(() => {
+      queries.forEach((query) => query.reset());
+    });
+  }
+  void queryClient.invalidateQueries({ queryKey: RECIPES_QUERY_KEY });
+  // Observers hear about the cleared pages on React Query's notify tick; wait for it
+  // so callers continue only once mounted lists have dropped the old rows.
+  await new Promise<void>((resolve) => {
+    notifyManager.schedule(resolve);
+  });
+}
+
+/**
+ * Applies the search-list revalidation policy to the app's client: when the
+ * app returns to the foreground or reconnects, mounted search lists refetch
+ * from page one whatever their stale time, so rows the viewer lost access to
+ * disappear.
+ */
+export function applySearchQueryDefaults(queryClient: QueryClient): void {
+  queryClient.setQueryDefaults(SEARCH_QUERY_KEY, {
+    refetchOnWindowFocus: 'always',
+    refetchOnReconnect: 'always',
+  });
+}
