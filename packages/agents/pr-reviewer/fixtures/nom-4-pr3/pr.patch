@@ -0,0 +1,192 @@
+import { describe, it, expect, vi, beforeEach } from 'vitest';
+import { Role } from '@prisma/client';
+
+// NOM-4 T3: cursor-paginated profile cookbooks. The session module runs for
+// real against a mocked Better Auth `getSession`, so these tests also prove the
+// targeted fresh-session read (disableCookieCache) for this route.
+const { getSession, prismaMock } = vi.hoisted(() => ({
+    getSession: vi.fn(),
+    prismaMock: { cookbook: { findMany: vi.fn() }, permission: { findMany: vi.fn() } },
+}));
+vi.mock('@/lib/auth', () => ({ auth: { api: { getSession } } }));
+vi.mock('next/headers', () => ({ headers: async () => new Headers() }));
+vi.mock('@/lib/prisma', () => ({ prisma: prismaMock }));
+
+import { GET } from './route';
+import { makeRequest, routeCtx } from '@/tests/helpers/request';
+import { admin, makeUser, other, owner } from '@/tests/fixtures/users';
+import type { CurrentUser } from '@/lib/auth/session';
+
+const moderator = makeUser({ id: 'user_mod', email: 'mod@example.com', role: Role.MODERATOR });
+const updatedAt = new Date('2026-09-01T12:00:00.000Z');
+
+const signIn = (user: CurrentUser | null) => {
+    getSession.mockResolvedValue(
+        user
+            ? {
+                  user: {
+                      id: user.id,
+                      name: user.name,
+                      email: user.email,
+                      image: user.image,
+                      role: user.role,
+                      suspended: user.suspended,
+                  },
+              }
+            : null,
+    );
+};
+
+const get = (qs = '', profileId = owner.id) =>
+    GET(makeRequest('GET', `/api/v1/users/${profileId}/cookbooks${qs}`), routeCtx({ id: profileId }));
+
+// Cookbooks with a tied updatedAt, as the select returns them.
+const cookbook = (id: string, isPrivate = false) => ({
+    id,
+    name: `Cookbook ${id}`,
+    description: null,
+    image: null,
+    isPrivate,
+    createdAt: new Date('2026-08-01T00:00:00.000Z'),
+    updatedAt,
+    _count: { recipes: 2 },
+});
+
+const lastArgs = () => prismaMock.cookbook.findMany.mock.calls.at(-1)?.[0];
+
+const firstCursor = async (qs = '?limit=2', profileId = owner.id) => {
+    prismaMock.cookbook.findMany.mockResolvedValueOnce([cookbook('c3'), cookbook('c2'), cookbook('c1')]);
+    const res = await get(qs, profileId);
+    expect(res.status).toBe(200);
+    const body = await res.json();
+    expect(typeof body.nextCursor).toBe('string');
+    return String(body.nextCursor);
+};
+
+beforeEach(() => {
+    vi.clearAllMocks();
+    signIn(null);
+    prismaMock.cookbook.findMany.mockResolvedValue([]);
+});
+
+describe('GET /users/:id/cookbooks — cursor envelope', () => {
+    it('always returns { items, nextCursor } with the existing item fields (updatedAt stays internal)', async () => {
+        prismaMock.cookbook.findMany.mockResolvedValueOnce([cookbook('c3'), cookbook('c2'), cookbook('c1')]);
+        const body = await (await get('?limit=2')).json();
+        expect(Object.keys(body).sort()).toEqual(['items', 'nextCursor']);
+        expect(body.items.map((c: { id: string }) => c.id)).toEqual(['c3', 'c2']);
+        expect(Object.keys(body.items[0]).sort()).toEqual(
+            ['_count', 'createdAt', 'description', 'id', 'image', 'isPrivate', 'name'].sort(),
+        );
+        expect(body.nextCursor).not.toBeNull();
+    });
+
+    it('an empty or short page ends with nextCursor null', async () => {
+        expect(await (await get()).json()).toEqual({ items: [], nextCursor: null });
+        prismaMock.cookbook.findMany.mockResolvedValueOnce([cookbook('c2'), cookbook('c1')]);
+        expect((await (await get('?limit=2')).json()).nextCursor).toBeNull();
+    });
+
+    it('orders by updatedAt DESC, id DESC with a bounded lookahead', async () => {
+        await get('?limit=2');
+        const args = lastArgs();
+        expect(args.orderBy).toEqual([{ updatedAt: 'desc' }, { id: 'desc' }]);
+        expect(args.take).toBe(3);
+        expect(args.select.updatedAt).toBe(true);
+    });
+
+    it.each([
+        ['absent', '', 25],
+        ['nonnumeric', '?limit=abc', 25],
+        ['below one', '?limit=0', 25],
+        ['above max', '?limit=500', 49],
+    ])('limit %s → take %s', async (_label, qs, take) => {
+        await get(qs);
+        expect(lastArgs().take).toBe(take);
+    });
+
+    it('applies the updatedAt/id keyset from the cursor, tied timestamps included', async () => {
+        const cursor = await firstCursor();
+        await get(`?limit=2&cursor=${cursor}`);
+        expect(lastArgs().where).toEqual({
+            userId: owner.id,
+            isPrivate: false,
+            OR: [{ updatedAt: { lt: updatedAt } }, { updatedAt, id: { lt: 'c2' } }],
+        });
+    });
+
+    it('resolves the session freshly (Better Auth disableCookieCache)', async () => {
+        await get();
+        expect(getSession).toHaveBeenCalledWith(expect.objectContaining({ query: { disableCookieCache: true } }));
+    });
+});
+
+describe('GET /users/:id/cookbooks — visibility scope on every page', () => {
+    it.each([
+        ['owner', owner],
+        ['SUPER_ADMIN', admin],
+    ])('%s omits the public-only predicate', async (_label, user) => {
+        signIn(user);
+        await get('?limit=2');
+        expect(lastArgs().where).toEqual({ userId: owner.id });
+    });
+
+    it.each([
+        ['MODERATOR', moderator],
+        ['another user', other],
+        ['anonymous', null],
+    ])('%s sees public cookbooks only', async (_label, user) => {
+        signIn(user);
+        await get('?limit=2');
+        expect(lastArgs().where).toEqual({ userId: owner.id, isPrivate: false });
+    });
+
+    it('owner pages keep their scope across cursors', async () => {
+        signIn(owner);
+        const cursor = await firstCursor();
+        await get(`?limit=2&cursor=${cursor}`);
+        expect(lastArgs().where).not.toHaveProperty('isPrivate');
+        expect(lastArgs().where.userId).toBe(owner.id);
+    });
+});
+
+describe('GET /users/:id/cookbooks — cursor binding (400)', () => {
+    const expectRejected = async (res: Response) => {
+        expect(res.status).toBe(400);
+        expect(prismaMock.cookbook.findMany).not.toHaveBeenCalled();
+    };
+
+    it('malformed cursor', async () => {
+        await expectRejected(await get('?cursor=garbage'));
+    });
+
+    it('an owner cursor reused by another viewer', async () => {
+        signIn(owner);
+        const cursor = await firstCursor();
+        signIn(other);
+        prismaMock.cookbook.findMany.mockClear();
+        await expectRejected(await get(`?limit=2&cursor=${cursor}`));
+    });
+
+    it('an owner cursor reused anonymously', async () => {
+        signIn(owner);
+        const cursor = await firstCursor();
+        signIn(null);
+        prismaMock.cookbook.findMany.mockClear();
+        await expectRejected(await get(`?limit=2&cursor=${cursor}`));
+    });
+
+    it('a SUPER_ADMIN cursor after the role is revoked', async () => {
+        signIn(admin);
+        const cursor = await firstCursor();
+        signIn({ ...admin, role: Role.USER });
+        prismaMock.cookbook.findMany.mockClear();
+        await expectRejected(await get(`?limit=2&cursor=${cursor}`));
+    });
+
+    it('a cursor for another profile', async () => {
+        const cursor = await firstCursor('?limit=2', other.id);
+        prismaMock.cookbook.findMany.mockClear();
+        await expectRejected(await get(`?limit=2&cursor=${cursor}`, owner.id));
+    });
+});
