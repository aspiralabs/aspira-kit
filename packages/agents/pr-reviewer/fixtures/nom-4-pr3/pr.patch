+
+type Query = Record<string, string>;
+const isExplore = (q: Query) => q.paginated === '1' && q.onlyPublic === 'true' && q.authorId === undefined;
+const isProfile = (q: Query) => q.paginated === '1' && q.authorId === 'u2';
