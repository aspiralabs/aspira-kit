@@ -0,0 +1,50 @@
+// @vitest-environment jsdom
+// P20 (NOM-4 F10): sign-out goes through our own route, not the better-auth
+// client, so useSession is not told. The page drops every cursor list before
+// leaving, so no list keeps the signed-out viewer's rows.
+import '@testing-library/jest-dom/vitest';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { render, waitFor } from '@testing-library/react';
+import { http, HttpResponse } from 'msw';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import LogoutPage from './page';
+import { resetCursorAccess } from '@/lib/api/api-fetcher';
+import { server, startMswServer } from '@/tests/msw';
+
+startMswServer();
+
+vi.mock('@/lib/api/api-fetcher', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('@/lib/api/api-fetcher')>();
+    return { ...actual, resetCursorAccess: vi.fn(actual.resetCursorAccess) };
+});
+
+const router = vi.hoisted(() => ({ push: vi.fn() }));
+vi.mock('next/navigation', () => ({ useRouter: () => router }));
+
+function renderPage() {
+    const queryClient = new QueryClient();
+    render(
+        <QueryClientProvider client={queryClient}>
+            <LogoutPage />
+        </QueryClientProvider>,
+    );
+    return queryClient;
+}
+
+beforeEach(() => {
+    vi.mocked(resetCursorAccess).mockClear();
+    router.push.mockClear();
+});
+
+describe('LogoutPage access reset (P20)', () => {
+    it('resets cursor access after signing out, before going to /login', async () => {
+        server.use(http.post('*/api/v1/auth/logout', () => HttpResponse.json({ ok: true })));
+        const queryClient = renderPage();
+        await waitFor(() => expect(router.push).toHaveBeenCalledWith('/login'));
+        expect(resetCursorAccess).toHaveBeenCalledWith(queryClient);
+        expect(vi.mocked(resetCursorAccess).mock.invocationCallOrder[0]).toBeLessThan(
+            router.push.mock.invocationCallOrder[0] ?? 0,
+        );
+    });
+});
