+const mockVerifyEmail = jest.fn<(...args: unknown[]) => Promise<unknown>>();
+
+jest.mock('expo-router', () => {
+  const { useEffect } = jest.requireActual<typeof import('react')>('react');
+  return {
+    useLocalSearchParams: () => mockRoute.useParams(),
+    useGlobalSearchParams: () => mockRoute.useParams(),
+    useRouter: () => mockRoute.router,
