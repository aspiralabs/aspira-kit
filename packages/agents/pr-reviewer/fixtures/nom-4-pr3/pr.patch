+}
+
+function expectCancelled(req: StubRequest) {
+  expect(req.signal?.aborted).toBe(true);
+}
+
+/** Page one answered, page two held in flight: the state every reset must clean up. */
+async function loadPageOneAndHoldPageTwo(match: (q: Query) => boolean, titles: string[]) {
+  const first = await net.nthSearch(1, match);
+  expect(first.query).not.toHaveProperty('cursor');
+  await act(async () => first.respond(pageOf(titles, 'old-cursor')));
+  await screen.findByText(titles[titles.length - 1]);
+  await reachEnd(titles[titles.length - 1]);
+  const second = await net.nthSearch(2, match);
+  expect(second.query.cursor).toBe('old-cursor');
+  return second;
+}
+
+/** Signs in through the real login screen with the given account. */
+async function signInThroughLogin(user: Viewer) {
+  mockSignInEmail.mockResolvedValue({ data: { user: { ...user } } });
+  await fireEvent.changeText(screen.getByPlaceholderText('you@example.com'), user.email);
+  await fireEvent.changeText(screen.getByPlaceholderText('••••••••'), 'correct horse');
+  await fireEvent.press(screen.getByText('Sign In'));
