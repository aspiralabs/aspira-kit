+    async function watchFor(page: Page, needle: string): Promise<() => Promise<string[]>> {
+        await page.evaluate((text) => {
+            const seen: string[] = [];
+            Object.assign(window, { __e2eSeen: seen });
+            new MutationObserver((records) => {
+                for (const record of records) {
+                    for (const node of Array.from(record.addedNodes)) {
+                        const content = node.textContent ?? '';
+                        if (content.includes(text)) seen.push(content.slice(0, 120));
+                    }
+                }
+            }).observe(document.body, { childList: true, subtree: true, characterData: true });
+        }, needle);
+        return () =>
+            page.evaluate(() => {
+                const value: unknown = Reflect.get(window, '__e2eSeen');
+                return Array.isArray(value) ? value.map(String) : [];
+            });
+    }
