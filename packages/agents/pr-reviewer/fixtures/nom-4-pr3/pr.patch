+
+// =============================================================================
+// NOM-4 explore pagination — API acceptance (A1–A4, features F1–F4)
+// =============================================================================
+// Real `next dev` handler, real session cookies, real Postgres. Every scenario
+// seeds its own rows under a per-scenario token (titles or snapshot ingredient
+// names carry it) so the shared e2e database never leaks into a traversal.
+// Orders the tests compute are derived from the seeded values only; the one
+// exception is relevance, whose score the database's own pg_trgm similarity()
+// produces (queried directly, never mocked).
+
+const SEARCH = '/api/v1/search';
+const BASE = new Date('2026-06-01T12:00:00.000Z');
+
+let prisma: PrismaClient;
+let anon: APIRequestContext;
+
+// Personas: two authors, a plain viewer, a staff member who keeps the role and
+// one who is demoted mid-traversal.
+let authorA: Persona;
+let authorB: Persona;
+let viewerP: Persona;
+let staffP: Persona;
+let demotedP: Persona;
+let asA: APIRequestContext;
+let asB: APIRequestContext;
+let asViewer: APIRequestContext;
+let asStaff: APIRequestContext;
+let asDemoted: APIRequestContext;
+
+// Terminated by "x" so no token is a substring of another (a1 vs a1cap).
+const token = (scenario: string) => `qz${RUN}${scenario}x`;
+
+test.beforeAll(async ({ baseURL }) => {
+    prisma = new PrismaClient();
+    authorA = await createPersona(prisma, 'authora', 'Avery Author');
+    authorB = await createPersona(prisma, 'authorb', 'Blake Author');
+    viewerP = await createPersona(prisma, 'viewer', 'Vic Viewer');
+    staffP = await createPersona(prisma, 'staff', 'Sam Staff', 'SUPER_ADMIN');
+    demotedP = await createPersona(prisma, 'demoted', 'Dee Demoted', 'MODERATOR');
+    anon = await playwrightRequest.newContext({ baseURL: baseURL! });
+    asA = await signIn(baseURL!, authorA);
+    asB = await signIn(baseURL!, authorB);
+    asViewer = await signIn(baseURL!, viewerP);
+    asStaff = await signIn(baseURL!, staffP);
+    asDemoted = await signIn(baseURL!, demotedP);
+});
+
+test.afterAll(async () => {
+    await Promise.all([anon, asA, asB, asViewer, asStaff, asDemoted].map((c) => c?.dispose()));
+    if (prisma) {
+        await cleanupRun(prisma);
+        await prisma.$disconnect();
+    }
+});
+
+// -----------------------------------------------------------------------------
+// Expected-order helpers (from the seeded fixture values)
+// -----------------------------------------------------------------------------
+const byIdDesc = (a: string, b: string) => (a < b ? 1 : a > b ? -1 : 0);
+const byIdAsc = (a: string, b: string) => -byIdDesc(a, b);
+
+interface Expect {
+    id: string;
+    createdAt: Date;
+    rating: number;
+    ratingCount: number;
+    prep: number | null;
+    cook: number | null;
+}
+
+function fromFixture(f: RecipeFixture, times: 'live' | 'approved' = 'live'): Expect {
+    const snap = f.published ? f.published : {};
+    const prep = times === 'approved' && snap.prepTime !== undefined ? snap.prepTime : (f.prepTime ?? null);
+    const cook = times === 'approved' && snap.cookTime !== undefined ? snap.cookTime : (f.cookTime ?? null);
+    return {
+        id: recipeId(f.key),
+        createdAt: f.createdAt ?? BASE,
+        rating: f.rating ?? 0,
+        ratingCount: f.ratingCount ?? 0,
+        prep,
+        cook,
+    };
+}
+
+const newestOrder = (rows: Expect[]) =>
+    [...rows].sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime() || byIdDesc(a.id, b.id)).map((r) => r.id);
+
+const topOrder = (rows: Expect[]) =>
+    [...rows]
+        .sort((a, b) => b.rating - a.rating || b.ratingCount - a.ratingCount || byIdDesc(a.id, b.id))
+        .map((r) => r.id);
+
+function timeOrder(rows: Expect[]): string[] {
+    const missing = (r: Expect) => (r.prep === null || r.cook === null ? 1 : 0);
+    const total = (r: Expect) => (r.prep ?? 0) + (r.cook ?? 0);
+    return [...rows]
+        .sort((a, b) => {
+            const rank = missing(a) - missing(b);
+            if (rank !== 0) return rank;
+            if (missing(a) === 0) return total(a) - total(b) || byIdAsc(a.id, b.id);
+            return byIdAsc(a.id, b.id);
+        })
+        .map((r) => r.id);
+}
+
+/** Relevance order from the database's own similarity() plus the public nutrition boost. */
+async function relevanceOrder(
+    rows: { id: string; title: string; boosted: boolean }[],
+    q: string,
+    boost: number,
+): Promise<string[]> {
+    const scored: { id: string; score: number }[] = [];
+    for (const row of rows) {
+        const [{ s }] = await prisma.$queryRaw<
+            { s: number }[]
+        >`SELECT similarity(${row.title}, ${q}::text)::float8 AS s`;
+        scored.push({ id: row.id, score: Number(s) + (row.boosted ? boost : 0) });
+    }
+    return scored.sort((a, b) => b.score - a.score || byIdDesc(a.id, b.id)).map((r) => r.id);
+}
+
+const ids = (items: SearchItem[]) => items.map((i) => i.id);
+
+function expectNoDuplicates(items: SearchItem[]) {
+    expect(new Set(ids(items)).size, `duplicate ids in ${JSON.stringify(ids(items))}`).toBe(items.length);
+}
+
+async function status(ctx: APIRequestContext, params: Params): Promise<{ code: number; body: unknown }> {
+    const res = await ctx.get(SEARCH, { params });
+    return { code: res.status(), body: await res.json() };
+}
+
+// =============================================================================
+// A1 — F1: cursor traversal and the legacy bare array
+// =============================================================================
+test.describe('A1: opted-in traversal reaches every row once; unopted callers keep the capped array', () => {
+    const T = token('a1');
+    const CAP = token('a1cap');
+    let seven: RecipeFixture[];
+
