+    id: 'user_1',
+    name: 'Ada',
+    email: 'ada@example.com',
+    image: null,
+    role: 'USER',
+    subscription: 'FREE',
+    requiresSetup: false,
+    suspended: false,
+};
+
+const cookbook: Cookbook = {
+    id: 'cb_1',
+    name: 'Weeknights',
+    description: null,
+    isPrivate: true,
+    isFeatured: false,
+    createdAt: new Date('2026-09-01'),
