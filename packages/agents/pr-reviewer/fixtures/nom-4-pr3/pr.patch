+];
+
+describe.each(SURFACES)('explore-pagination spec § F10: resetSearchAccess on the $name list', (surface) => {
+  it('cancels the in-flight page, removes loaded rows at once and restarts at page one; the old response cannot restore them', async () => {
+    const client = clientFor(USER_A);
+    await surface.render(client);
+    const oldNext = await loadPageOneAndHoldPageTwo(surface.match, ['Old One', 'Old Two']);
