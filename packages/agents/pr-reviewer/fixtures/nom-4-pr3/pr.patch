new file mode 100644
index 0000000..3d9745a
--- /dev/null
+++ b/apps/web/tests/integration/helpers/search-pagination-seed.ts
@@ -0,0 +1,260 @@
+import type { Course, ModerationStatus, RecipeVisibility } from '@prisma/client';
+import { expect } from 'vitest';
+
+import { GET as cookbooksGET } from '@/app/api/v1/users/[id]/cookbooks/route';
+import { GET as searchGET } from '@/app/api/v1/search/route';
+import { contentToText, type PublicRecipeContent } from '@/lib/moderation/public-recipe';
+import { prisma } from '@/lib/prisma';
+import { makeRequest, routeCtx } from '@/tests/helpers/request';
+import {
+    cookbookPageSchema,
+    recipeSearchItemSchema,
+    recipeSearchPageSchema,
+    type CookbookPage,
+    type RecipeSearchPage,
+    type RecipeSearchResult,
+} from '@/types/search';
+
+// Seeding and request helpers for the NOM-4 pagination suite
+// (tests/integration/search-pagination.test.ts). Recipes are written in the
+// shape the moderation flow leaves them (lib/moderation/decide.ts
+// approveReview): a frozen snapshot whose searchText comes from the app's own
+// contentToText, pointed at by publishedSnapshotId. Seeding is batched
+// (createMany + one pointer UPDATE) so every test can reseed after the
+// harness's per-test TRUNCATE. Route handlers are called directly; the viewer
+// comes from the suite's getCurrentUser mock.
+
+/** One ingredient line of a frozen snapshot: the line name, or only the linked catalog name. */
+export interface SnapshotLine {
+    name: string | null;
+    linkedName?: string;
+}
+
+/** The approved content a snapshot freezes. Missing fields copy the live recipe. */
+export interface SnapshotFixture {
+    title?: string;
+    prepTime?: number | null;
+    cookTime?: number | null;
+    lines?: SnapshotLine[];
+}
+
+export interface RecipeFixture {
+    /** Lowercase letters and digits only, so JS and Postgres order ids the same way. */
+    id: string;
+    authorId: string;
+    title: string;
+    createdAt?: Date;
+    rating?: number;
+    ratingCount?: number;
+    prepTime?: number | null;
+    cookTime?: number | null;
+    nutritionComplete?: boolean;
+    /** Approved snapshot content; omit (or false) for a never-published recipe. */
+    published?: SnapshotFixture | false;
+    /** PUBLIC by default when published, PRIVATE otherwise. */
+    visibility?: RecipeVisibility;
+    moderationStatus?: ModerationStatus;
+    takedownAt?: Date | null;
+}
+
+// A type alias (not an interface) so it is both Prisma JSON input and a PublicRecipeContent.
+type SnapshotData = {
+    title: string;
+    image: null;
+    previewText: null;
+    description: null;
+    yield: number;
+    prepTime: number | null;
+    cookTime: number | null;
+    course: Course | null;
+    cuisineId: string | null;
+    tags: { id: string; name: string }[];
+    ingredientGroups: {
+        name: string;
+        order: number;
+        ingredients: {
+            name: string | null;
+            amount: number;
+            amountKind: string;
+            amountMax: null;
+            unit: null;
+            ingredient?: { name: string };
+        }[];
+    }[];
+    nutrition: null;
+    derivedLabels: null;
+};
+
+function snapshotContent(fixture: RecipeFixture, snapshot: SnapshotFixture): SnapshotData {
+    return {
+        title: snapshot.title ?? fixture.title,
+        image: null,
+        previewText: null,
+        description: null,
+        yield: 2,
+        prepTime: snapshot.prepTime === undefined ? (fixture.prepTime ?? null) : snapshot.prepTime,
+        cookTime: snapshot.cookTime === undefined ? (fixture.cookTime ?? null) : snapshot.cookTime,
+        course: null,
+        cuisineId: null,
+        tags: [],
+        ingredientGroups: [
+            {
+                name: 'Main',
+                order: 1,
+                ingredients: (snapshot.lines ?? []).map((line) => ({
+                    name: line.name,
+                    amount: 1,
+                    amountKind: 'KNOWN',
+                    amountMax: null,
+                    unit: null,
+                    ...(line.linkedName ? { ingredient: { name: line.linkedName } } : {}),
+                })),
+            },
+        ],
+        nutrition: null,
+        derivedLabels: null,
+    };
+}
+
+function snapshotRow(fixture: RecipeFixture, snapshot: SnapshotFixture, id: string) {
+    const data = snapshotContent(fixture, snapshot);
+    const content: PublicRecipeContent = data;
+    return { id, recipeId: fixture.id, data, searchText: contentToText(content), policyVersion: 'test' };
+}
+
+/** Seeds the fixtures in three statements: recipes, snapshots, then the current-snapshot pointers. */
+export async function seedRecipes(fixtures: RecipeFixture[]): Promise<void> {
+    await prisma.recipe.createMany({
+        data: fixtures.map((f) => {
+            const published = f.published ?? false;
+            return {
+                id: f.id,
+                title: f.title,
+                authorId: f.authorId,
+                private: !published,
+                previewText: `${f.title} preview`,
+                yield: 2,
+                prepTime: f.prepTime ?? null,
+                cookTime: f.cookTime ?? null,
+                rating: f.rating ?? 0,
+                ratingCount: f.ratingCount ?? 0,
+                nutritionComplete: f.nutritionComplete ?? false,
+                visibility: f.visibility ?? (published ? 'PUBLIC' : 'PRIVATE'),
+                moderationStatus: f.moderationStatus ?? (published ? 'APPROVED' : 'NONE'),
+                takedownAt: f.takedownAt ?? null,
+                ...(f.createdAt ? { createdAt: f.createdAt } : {}),
+            };
+        }),
+    });
+    const snapshots = fixtures.flatMap((f) => (f.published ? [snapshotRow(f, f.published, `${f.id}s1`)] : []));
+    if (snapshots.length === 0) return;
+    await prisma.recipePublishedSnapshot.createMany({ data: snapshots });
+    const ids = snapshots.map((s) => s.recipeId);
+    await prisma.$executeRaw`
+        UPDATE "Recipe" r SET "publishedSnapshotId" = s.id
+        FROM "RecipePublishedSnapshot" s
+        WHERE s."recipeId" = r.id AND r.id = ANY(${ids}::text[])`;
+}
+
+/** Freezes `snapshot` as a new current snapshot, the way approveReview republishes. */
+export async function republish(fixture: RecipeFixture, snapshot: SnapshotFixture, version: number): Promise<void> {
+    const row = snapshotRow(fixture, snapshot, `${fixture.id}s${version}`);
+    await prisma.recipePublishedSnapshot.create({ data: row });
+    await prisma.recipe.update({ where: { id: fixture.id }, data: { publishedSnapshotId: row.id } });
+}
+
+/** A creation time `minutes` before `base`, so newest order is controlled. */
+export function minutesAgo(base: Date, minutes: number): Date {
+    return new Date(base.getTime() - minutes * 60_000);
+}
+
+// -----------------------------------------------------------------------------
+// Requests
+// -----------------------------------------------------------------------------
+export type Params = Record<string, string>;
+
+export interface RawResponse {
+    status: number;
+    body: unknown;
+}
+
+/** GET /api/v1/search with exactly these params (no opt-in added). */
+export async function searchRaw(params: Params): Promise<RawResponse> {
+    const qs = new URLSearchParams(params).toString();
+    const res = await searchGET(makeRequest('GET', `/api/v1/search?${qs}`), routeCtx({}));
+    return { status: res.status, body: await res.json() };
+}
+
+/** One opted-in page (`paginated=1`), parsed with the app's own page schema. */
+export async function searchPage(params: Params): Promise<RecipeSearchPage> {
+    const res = await searchRaw({ paginated: '1', ...params });
+    expect(res.status, `GET /search ${JSON.stringify(params)}: ${JSON.stringify(res.body)}`).toBe(200);
+    return recipeSearchPageSchema.parse(res.body);
+}
+
+/** An unopted request: a bare array of search items. */
+export async function searchArray(params: Params): Promise<RecipeSearchResult[]> {
+    const res = await searchRaw(params);
+    expect(res.status, JSON.stringify(res.body)).toBe(200);
+    return recipeSearchItemSchema.array().parse(res.body);
+}
+
+export interface Traversal<T> {
+    pages: { items: T[]; nextCursor: string | null }[];
+    items: T[];
+}
+
+async function follow<T>(
+    fetchPage: (cursor: string | null) => Promise<{ items: T[]; nextCursor: string | null }>,
+    maxPages: number,
+): Promise<Traversal<T>> {
+    const pages: { items: T[]; nextCursor: string | null }[] = [];
+    let cursor: string | null = null;
+    do {
+        const page = await fetchPage(cursor);
+        pages.push(page);
+        cursor = page.nextCursor;
+        if (pages.length > maxPages) throw new Error('traversal did not terminate');
+    } while (cursor !== null);
+    return { pages, items: pages.flatMap((p) => p.items) };
+}
+
+/** Follows nextCursor to the end of an opted-in search. */
+export function traverse(params: Params, maxPages = 60): Promise<Traversal<RecipeSearchResult>> {
+    return follow((cursor) => searchPage(cursor === null ? params : { ...params, cursor }), maxPages);
+}
+
+/** GET /api/v1/users/{id}/cookbooks with these params. */
+export async function cookbooksRaw(profileId: string, params: Params): Promise<RawResponse> {
+    const qs = new URLSearchParams(params).toString();
+    const res = await cookbooksGET(
+        makeRequest('GET', `/api/v1/users/${profileId}/cookbooks${qs ? `?${qs}` : ''}`),
+        routeCtx({ id: profileId }),
+    );
+    return { status: res.status, body: await res.json() };
+}
+
+export async function cookbooksPage(profileId: string, params: Params): Promise<CookbookPage> {
+    const res = await cookbooksRaw(profileId, params);
+    expect(res.status, `GET cookbooks ${JSON.stringify(params)}: ${JSON.stringify(res.body)}`).toBe(200);
+    return cookbookPageSchema.parse(res.body);
+}
+
+export function traverseCookbooks(
+    profileId: string,
+    params: Params,
+    maxPages = 60,
+): Promise<Traversal<CookbookPage['items'][number]>> {
+    return follow((cursor) => cookbooksPage(profileId, cursor === null ? params : { ...params, cursor }), maxPages);
+}
+
+/** Whether a body is the API's `{ error }` payload. */
+export function hasErrorMessage(body: unknown): boolean {
+    return (
+        typeof body === 'object' &&
+        body !== null &&
+        'error' in body &&
+        typeof body.error === 'string' &&
+        body.error.length > 0
+    );
+}
diff --git a/apps/web/tests/integration/search-pagination.test.ts b/apps/web/tests/integration/search-pagination.test.ts
new file mode 100644
index 0000000..48dffa1
--- /dev/null
+++ b/apps/web/tests/integration/search-pagination.test.ts
@@ -0,0 +1,985 @@
+import { Prisma, Role, SubscriptionPlanKey } from '@prisma/client';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { NUTRITION_RANK_BOOST } from '@/config/nutrition';
+import type { CurrentUser } from '@/lib/auth/session';
+import { prisma } from '@/lib/prisma';
+import type { RecipeSearchResult } from '@/types/search';
+import { seedUser } from './helpers/nutrition-seed';
+import {
+    cookbooksPage,
+    cookbooksRaw,
+    hasErrorMessage,
+    minutesAgo,
+    republish,
+    searchArray,
+    searchPage,
+    searchRaw,
+    seedRecipes,
+    traverse,
+    traverseCookbooks,
+    type Params,
+    type RecipeFixture,
+} from './helpers/search-pagination-seed';
+
+// NOM-4 explore pagination — API acceptance A1–A4 (features F1–F4) against real
+// Postgres: GET /api/v1/search and GET /api/v1/users/{id}/cookbooks are called
+// directly with real SQL (keyset predicates, pg_trgm similarity, the canonical
+// public predicate, block anti-joins). Only the session is faked: the
+// getCurrentUser mock re-reads the signed-in user's row on every request, which
+// is what the routes' fresh (cookie-cache-bypassing) session read does, so a
+// role change made between pages applies to the next page. Expected orders are
+// computed from the seeded values; relevance scores come from the database's
+// own similarity().
+
+const session = vi.hoisted(() => ({ userId: null as string | null, freshReads: 0, reads: 0 }));
+vi.mock('@/lib/auth/session', () => ({
+    getCurrentUser: async (options?: { fresh?: boolean }): Promise<CurrentUser | null> => {
+        session.reads++;
+        if (options?.fresh === true) session.freshReads++;
+        if (session.userId === null) return null;
+        const row = await prisma.user.findUnique({ where: { id: session.userId } });
+        if (!row) return null;
+        return {
+            id: row.id,
+            name: row.name,
+            email: row.email ?? `${row.id}@example.test`,
+            image: row.image,
+            role: row.role,
+            subscription: SubscriptionPlanKey.FREE,
+            requiresSetup: false,
+            suspended: row.suspended,
+        };
+    },
+}));
+
+const BASE = new Date('2026-06-01T12:00:00.000Z');
+
+interface Personas {
+    authorA: string;
+    authorB: string;
+    viewer: string;
+    staff: string;
+    moderator: string;
+}
+
+let who: Personas;
+
+/** Signs in as `userId` (null = anonymous) for the following requests. */
+function as(userId: string | null): void {
+    session.userId = userId;
+}
+
+beforeEach(async () => {
+    session.userId = null;
+    session.freshReads = 0;
+    session.reads = 0;
+    who = {
+        authorA: (await seedUser('USER', 'authora')).id,
+        authorB: (await seedUser('USER', 'authorb')).id,
+        viewer: (await seedUser('USER', 'viewer')).id,
+        staff: (await seedUser('SUPER_ADMIN', 'staff')).id,
+        moderator: (await seedUser('MODERATOR', 'moderator')).id,
+    };
+});
+
+// -----------------------------------------------------------------------------
+// Expected orders (from the seeded fixture values)
+// -----------------------------------------------------------------------------
+const byIdDesc = (a: string, b: string) => (a < b ? 1 : a > b ? -1 : 0);
+const byIdAsc = (a: string, b: string) => -byIdDesc(a, b);
+
+interface Expect {
+    id: string;
+    createdAt: Date;
+    rating: number;
+    ratingCount: number;
+    prep: number | null;
+    cook: number | null;
+}
+
+function fromFixture(f: RecipeFixture, times: 'live' | 'approved' = 'live'): Expect {
+    const snap = f.published ? f.published : {};
+    const prep = times === 'approved' && snap.prepTime !== undefined ? snap.prepTime : (f.prepTime ?? null);
+    const cook = times === 'approved' && snap.cookTime !== undefined ? snap.cookTime : (f.cookTime ?? null);
+    return {
+        id: f.id,
+        createdAt: f.createdAt ?? BASE,
+        rating: f.rating ?? 0,
+        ratingCount: f.ratingCount ?? 0,
+        prep,
+        cook,
+    };
+}
+
+const newestOrder = (rows: Expect[]) =>
+    [...rows].sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime() || byIdDesc(a.id, b.id)).map((r) => r.id);
+
+const topOrder = (rows: Expect[]) =>
+    [...rows]
+        .sort((a, b) => b.rating - a.rating || b.ratingCount - a.ratingCount || byIdDesc(a.id, b.id))
+        .map((r) => r.id);
+
+function timeOrder(rows: Expect[]): string[] {
+    const missing = (r: Expect) => (r.prep === null || r.cook === null ? 1 : 0);
+    const total = (r: Expect) => (r.prep ?? 0) + (r.cook ?? 0);
+    return [...rows]
+        .sort((a, b) => {
+            const rank = missing(a) - missing(b);
+            if (rank !== 0) return rank;
+            if (missing(a) === 0) return total(a) - total(b) || byIdAsc(a.id, b.id);
+            return byIdAsc(a.id, b.id);
+        })
+        .map((r) => r.id);
+}
+
+function orderFor(sort: 'newest' | 'top' | 'time', rows: Expect[]): string[] {
+    if (sort === 'newest') return newestOrder(rows);
+    if (sort === 'top') return topOrder(rows);
+    return timeOrder(rows);
+}
+
+/** Relevance order: the database's own similarity() plus the public nutrition boost, id DESC on ties. */
+async function relevanceOrder(rows: { id: string; title: string; boosted: boolean }[], q: string, boost: number) {
+    const scored: { id: string; score: number }[] = [];
+    for (const row of rows) {
+        const [{ s }] = await prisma.$queryRaw<{ s: number }[]>(
+            Prisma.sql`SELECT similarity(${row.title}, ${q}::text)::float8 AS s`,
+        );
+        scored.push({ id: row.id, score: Number(s) + (row.boosted ? boost : 0) });
+    }
+    return scored.sort((a, b) => b.score - a.score || byIdDesc(a.id, b.id)).map((r) => r.id);
+}
+
+const ids = (items: RecipeSearchResult[]) => items.map((i) => i.id);
+
+function expectNoDuplicates(items: { id: string }[]) {
+    const list = items.map((i) => i.id);
+    expect(new Set(list).size, `duplicate ids in ${JSON.stringify(list)}`).toBe(list.length);
+}
+
+// =============================================================================
+// A1 — F1: cursor traversal and the legacy bare array
+// =============================================================================
+describe('A1 (F1): opted-in traversal reaches every row once; unopted callers keep the capped array', () => {
+    const T = 'tagine';
+    const CAP = 'capword';
+    let seven: RecipeFixture[];
+
+    beforeEach(async () => {
+        // Seven eligible public recipes with deliberate ties: three share one
+        // createdAt, two another; all rate 0/0, same times, equal-length titles.
+        seven = ['a', 'b', 'c', 'd', 'e', 'f', 'g'].map((k, i) => ({
+            id: `a1${k}`,
