+/** `{ items: [{ id }], nextCursor }` from the cookbook endpoint (ids only). */
+function toSearchPageLike(body: unknown): { ids: string[]; nextCursor: string | null } {
+    if (typeof body !== 'object' || body === null || !('items' in body) || !('nextCursor' in body)) {
+        throw new Error(`not a cookbook page: ${JSON.stringify(body)}`);
+    }
+    const items = Array.isArray(body.items) ? body.items : [];
+    const next = body.nextCursor;
+    return {
+        ids: items.map((item: unknown) =>
+            typeof item === 'object' && item !== null && 'id' in item && typeof item.id === 'string' ? item.id : '',
+        ),
+        nextCursor: typeof next === 'string' ? next : null,
+    };
+}
+
+async function collectCookbooks(ctx: APIRequestContext, url: string): Promise<string[]> {
+    const ids: string[] = [];
+    let cursor: string | null = null;
+    do {
+        const res = await ctx.get(url, { params: cursor === null ? { limit: '7' } : { limit: '7', cursor } });
+        expect(res.status()).toBe(200);
+        const page = toSearchPageLike(await res.json());
+        ids.push(...page.ids);
+        cursor = page.nextCursor;
+    } while (cursor !== null);
+    return ids;
+}
