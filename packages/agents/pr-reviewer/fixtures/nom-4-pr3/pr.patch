+// Fake HTTP server for component and fetcher tests (TS-141, TEST-003). The real
+// fetcher runs and its request is answered at the network boundary, so response
+// validation, cursors and error handling are exercised too.
+//
+// Opt in per test file:
+//     import { http, HttpResponse } from 'msw';
+//     import { server, startMswServer } from '@/tests/msw';
+//     startMswServer();
+//     server.use(http.get('*/api/v1/search', () => HttpResponse.json({ items: [], nextCursor: null })));
+import { setupServer } from 'msw/node';
+import { transferableAbortController } from 'node:util';
+import { afterAll, afterEach, beforeAll, beforeEach, vi } from 'vitest';
+
+export const server = setupServer();
+
+// jsdom swaps in its own AbortController, and Node's fetch (which MSW intercepts)
+// rejects a jsdom AbortSignal. React Query hands every request a signal, so each
+// test gets Node's controller class back (util exposes an instance of it).
+const nodeAbortController = transferableAbortController().constructor;
+
+/**
+ * Starts the fake server for this test file and fails on any request no handler answers.
+ * Also restores Node's AbortController before each test (re-applied because files may
+ * call vi.unstubAllGlobals() in afterEach).
+ */
+export function startMswServer() {
+    beforeAll(() => server.listen({ onUnhandledRequest: 'error' }));
+    beforeEach(() => {
+        vi.stubGlobal('AbortController', nodeAbortController);
+    });
+    afterEach(() => server.resetHandlers());
+    afterAll(() => server.close());
+}
