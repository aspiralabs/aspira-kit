+// @vitest-environment jsdom
+// P20 (NOM-4 F10): making a recipe private or deleting it drops every cursor
+// list, so Explore, profile, My Recipes and the picker restart without it.
+// HTTP is answered by MSW; the kit Menu and the confirmation modal are doubles.
+import '@testing-library/jest-dom/vitest';
+import { TooltipProviderPrimitive } from '@aspiralabs/ui';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { fireEvent, render, screen } from '@testing-library/react';
+import { http, HttpResponse } from 'msw';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { RecipeTitleSection } from './recipe-title-section';
+import { resetCursorAccess } from '@/lib/api/api-fetcher';
+import { server, startMswServer } from '@/tests/msw';
+
+startMswServer();
+
+vi.mock('@/lib/api/api-fetcher', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('@/lib/api/api-fetcher')>();
+    return { ...actual, resetCursorAccess: vi.fn(actual.resetCursorAccess) };
+});
+
+vi.mock('@aspiralabs/ui', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('@aspiralabs/ui')>();
+    return {
+        ...actual,
+        // The kit Menu needs pointer/layout APIs jsdom lacks; render each option as a button.
+        Menu: ({ options }: { options: Array<{ key: string; label: string; action?: () => void }> }) => (
+            <div>
+                {options.map((option) => (
+                    <actual.Button key={option.key} type="button" onClick={option.action}>
+                        {option.label}
+                    </actual.Button>
+                ))}
+            </div>
+        ),
+    };
+});
+
+type ConfirmProps = { onConfirm: (modal: { hide: () => void }) => Promise<void> };
+const modal = vi.hoisted((): { props: ConfirmProps | null } => ({ props: null }));
+vi.mock('@ebay/nice-modal-react', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('@ebay/nice-modal-react')>();
+    return {
+        ...actual,
+        default: {
+            ...actual.default,
+            show: (_component: unknown, props: ConfirmProps) => {
+                modal.props = props;
+            },
+        },
+    };
+});
+
+const router = vi.hoisted(() => ({ push: vi.fn(), refresh: vi.fn() }));
+vi.mock('next/navigation', () => ({ useRouter: () => router }));
+vi.mock('@/lib/auth/auth.client', () => ({ useSession: () => ({ data: null }) }));
+vi.mock('sonner', () => ({ toast: { success: vi.fn(), error: vi.fn() } }));
+vi.mock('@/components/providers/global-level-provider', () => ({
+    usePermission: () => ({ canAccess: () => true }),
+}));
+// Not under test; they pull in data-bound UI.
+vi.mock('@/components/recipe/recipe-stat-search', () => ({ RecipeStatSearch: () => null }));
+vi.mock('@/components/ui/project/editable-textarea', () => ({ EditableTextArea: () => null }));
+
+// A published recipe as the detail API returns it to its author.
+const publishedRecipe = {
+    id: 'rec-1',
+    title: 'Sourdough',
+    authorId: 'author-1',
+    author: { name: 'Ada' },
+    previewText: null,
+    rating: 0,
+    ratingCount: 0,
+    prepTime: 10,
+    cookTime: 20,
+    cuisineId: null,
+    course: null,
+    private: false,
+    moderationStatus: 'APPROVED',
+};
+
+function renderSection() {
+    const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    render(
+        <QueryClientProvider client={queryClient}>
+            <TooltipProviderPrimitive>
+                <RecipeTitleSection recipe={publishedRecipe} cuisines={[]} />
+            </TooltipProviderPrimitive>
+        </QueryClientProvider>,
+    );
+    return queryClient;
+}
+
+async function confirm(label: RegExp) {
+    fireEvent.click(await screen.findByRole('button', { name: label }));
+    const props = modal.props;
+    if (!props) throw new Error('The confirmation modal was not opened');
+    await props.onConfirm({ hide: vi.fn() });
+}
+
+beforeEach(() => {
+    modal.props = null;
+    vi.mocked(resetCursorAccess).mockClear();
+    router.push.mockClear();
+    router.refresh.mockClear();
+    server.use(
+        http.post('*/api/v1/recipes/:id/unpublish', () => HttpResponse.json({ ok: true })),
+        http.delete('*/api/v1/recipes/:id', () => HttpResponse.json({ ok: true })),
+    );
+});
+
+describe('RecipeTitleSection access reset (P20)', () => {
+    it('make private: resets cursor access with the app QueryClient before refreshing', async () => {
+        const queryClient = renderSection();
+        router.refresh.mockImplementation(() => {
+            expect(resetCursorAccess).toHaveBeenCalledTimes(1);
+        });
+        await confirm(/make private/i);
+        expect(resetCursorAccess).toHaveBeenCalledWith(queryClient);
+        expect(router.refresh).toHaveBeenCalledTimes(1);
+    });
+
+    it('delete: resets cursor access before navigating away', async () => {
+        const queryClient = renderSection();
+        await confirm(/delete recipe/i);
+        expect(resetCursorAccess).toHaveBeenCalledWith(queryClient);
+        expect(vi.mocked(resetCursorAccess).mock.invocationCallOrder[0]).toBeLessThan(
+            router.push.mock.invocationCallOrder[0] ?? 0,
+        );
+    });
+
+    it('a failed unpublish does not reset access', async () => {
+        server.use(http.post('*/api/v1/recipes/:id/unpublish', () => HttpResponse.json({}, { status: 500 })));
+        renderSection();
+        await confirm(/make private/i);
+        expect(resetCursorAccess).not.toHaveBeenCalled();
+    });
+});
