+// ---------------------------------------------------------------------------
+// Deferred MSW search handler: each request waits until the test answers it.
+// ---------------------------------------------------------------------------
+type SearchCall = { url: URL; respond: (body: JsonBodyType, status?: number) => void };
+let calls: SearchCall[] = [];
+
+function serveDeferredSearch() {
+    server.use(
+        http.get(
+            '*/api/v1/search',
+            ({ request }) =>
+                new Promise<Response>((resolve) => {
+                    calls.push({
+                        url: new URL(request.url),
+                        respond: (body, status = 200) => resolve(HttpResponse.json(body, { status })),
+                    });
+                }),
+        ),
+    );
+}
+
+async function answer(index: number, body: JsonBodyType, status = 200) {
+    const call = calls[index];
+    if (!call) throw new Error(`No search request #${index}; saw ${calls.length}`);
+    // The body still has to cross MSW, fetch, JSON parsing and React Query.
+    await act(async () => {
+        call.respond(body, status);
+        await new Promise((resolve) => setTimeout(resolve, 20));
+    });
+}
