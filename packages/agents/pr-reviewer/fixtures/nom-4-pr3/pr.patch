+// NOM-4 explore-pagination P23: mobile acceptance scenarios A8 (F8), A9 (F9)
+// and A12 (F10). Each scenario is a user journey across the REAL screens
+// (Explore, another cook's profile, the meal-plan picker, login) inside a
+// real React Query provider. HTTP is controlled at the network boundary: the
+// fetch stub holds every /search request until the test answers it, so the
+// real lib/api.ts client and its Zod validation run, and response ordering
+// (late, failed, aborted) is chosen by the test.
+//
+// The smaller unit cases for the same contracts live in
+// search-pagination.test.tsx and ../search-access.test.tsx; these scenarios
+// chain those behaviors the way a person would meet them.
+import { afterEach, beforeEach, describe, expect, it, jest } from '@jest/globals';
+import { focusManager, type QueryClient } from '@tanstack/react-query';
+import { act, fireEvent, screen, waitFor } from '@testing-library/react-native';
+import { Pressable, Text } from 'react-native';
+import ExploreScreen from '../../app/(tabs)/explore';
+import UserProfileScreen from '../../app/user/[id]';
+import MealPlanScreen from '../../app/meal-plan';
+import LoginScreen from '../../app/(auth)/login';
+import { SESSION_KEY, useAuth } from '../../hooks/useAuth';
+import { applySearchQueryDefaults } from '../../lib/search-access';
+import { pressAlertButton, spyOnAlert } from '../../test-utils/async';
+import { makeTestQueryClient, renderWithProviders } from '../../test-utils/render';
+import {
+  createRouteStore,
+  installFetchStub,
+  pageOf,
+  row,
+  viewer,
+  type CursorPage,
+  type FetchStub,
+  type StubRequest,
+  type Viewer,
