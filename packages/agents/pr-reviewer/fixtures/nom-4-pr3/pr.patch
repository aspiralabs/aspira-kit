+
+const USER_A = viewer('user-a', 'Ada');
+const USER_B = viewer('user-b', 'Bea');
+
+let net: FetchStub;
+let blocked: boolean;
+
+beforeEach(() => {
+  jest.spyOn(console, 'log').mockImplementation(() => undefined);
