+/** Fires the list's onEndReached from inside it (fireEvent walks up to the FlatList). */
+async function reachEnd(lastVisibleTitle: string) {
+  await fireEvent(screen.getByText(lastVisibleTitle), 'endReached');
+}
+
+/** Lets pending effects and promise callbacks run, so "no new request" checks are meaningful. */
+async function settle(ms = 20) {
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, ms));
+  });
+}
+
+/**
+ * Lists are virtualized: with no layout, a FlatList renders only its first
+ * cells. Laying the list out (as a device does when it measures the screen)
+ * lets it render the rows a person would scroll to. The scroll host is found
+ * from a visible row, the way a person's scroll gesture starts on the list.
+ */
+async function layOutList(visibleTitle: string) {
+  let node: ReturnType<typeof screen.getByText> | null = screen.getByText(visibleTitle);
+  while (node && !(node.props.onScroll && node.props.onLayout)) node = node.parent;
+  if (!node) throw new Error(`no scrolling list holds "${visibleTitle}"`);
+  await fireEvent(node, 'layout', { nativeEvent: { layout: { x: 0, y: 0, width: 400, height: 800 } } });
+  // Content far taller than the viewport: laying out never counts as reaching the end.
+  await fireEvent(node, 'contentSizeChange', 400, 100_000);
+  await settle(120);
+}
+
+async function answer(req: StubRequest, page: CursorPage) {
+  await act(async () => req.respond(page));
+}
+
+/** Titles `${prefix} 1` .. `${prefix} n` with ids `id-<title>`. */
+function titles(prefix: string, from: number, to: number): string[] {
+  return Array.from({ length: to - from + 1 }, (_, i) => `${prefix} ${from + i}`);
+}
+
+function chip(name: string) {
