+const searchCases: { sort: SearchCursorContext['sort']; keys: CursorKeys }[] = [
+    { sort: 'relevance', keys: { sort: 'relevance', score: 0.4321, id: 'r9' } },
+    { sort: 'newest', keys: { sort: 'newest', createdAt: fixedDate, id: 'r8' } },
+    { sort: 'top', keys: { sort: 'top', rating: 0, ratingCount: 0, id: 'r7' } },
+    { sort: 'time', keys: { sort: 'time', missingRank: 0, totalMinutes: 45, id: 'r6' } },
+    { sort: 'time', keys: { sort: 'time', missingRank: 1, totalMinutes: null, id: 'r5' } },
+];
+
+// Decode a cursor's raw payload so tests can tamper with it.
+const rawPayload = (cursor: string): Record<string, unknown> =>
+    JSON.parse(Buffer.from(cursor, 'base64url').toString('utf8'));
+const reencode = (payload: unknown): string => Buffer.from(JSON.stringify(payload), 'utf8').toString('base64url');
+
+const expectBadCursor = (fn: () => unknown) => {
+    let caught: unknown;
+    try {
+        fn();
+    } catch (err) {
+        caught = err;
+    }
+    expect(caught).toBeInstanceOf(ApiError);
+    expect(caught).toMatchObject({ status: 400 });
+};
+
+describe('parseCursorLimit', () => {
+    it.each([
+        ['absent', null],
+        ['undefined', undefined],
+        ['empty', ''],
+        ['nonnumeric', 'abc'],
+        ['zero', '0'],
+        ['negative', '-5'],
+        ['NaN', 'NaN'],
+        ['Infinity', 'Infinity'],
+    ])('%s limit resolves to the default 24', (_label, raw) => {
+        expect(parseCursorLimit(raw)).toBe(24);
+        expect(DEFAULT_CURSOR_LIMIT).toBe(24);
+    });
+
+    it('clamps 500 to 48', () => {
+        expect(parseCursorLimit('500')).toBe(48);
+        expect(MAX_CURSOR_LIMIT).toBe(48);
+    });
+
+    it('keeps an in-range limit and produces an integer', () => {
+        expect(parseCursorLimit('2')).toBe(2);
+        expect(parseCursorLimit('48')).toBe(48);
+        expect(parseCursorLimit('7.9')).toBe(7);
+    });
+});
+
+describe('normalizeSearchCursorContext', () => {
+    it('treats diet as a deduplicated, sorted set', () => {
+        const a = searchContext({ diet: ['keto', 'high-protein', 'keto'] });
+        const b = searchContext({ diet: ['high-protein', 'keto'] });
+        expect(a.diet).toEqual(['high-protein', 'keto']);
+        const cursor = encodeCursor({ sort: 'relevance', score: 1, id: 'r1' }, a);
+        expect(decodeCursor(cursor, b, 'relevance')).toEqual({ sort: 'relevance', score: 1, id: 'r1' });
+    });
+});
+
+describe('encodeCursor / decodeCursor round trip', () => {
+    it.each(searchCases)('search $sort keeps every comparison value ($keys)', ({ sort, keys }) => {
+        const context = searchContext({ sort });
+        const cursor = encodeCursor(keys, context);
+        expect(cursor).toMatch(/^[A-Za-z0-9_-]+$/);
+        expect(decodeCursor(cursor, context, sort)).toEqual(keys);
+    });
+
+    it('cookbooks keeps updatedAt and id', () => {
+        const keys: CursorKeys = { sort: 'cookbooks', updatedAt: fixedDate, id: 'cb2' };
+        const cursor = encodeCursor(keys, cookbookContext());
+        expect(decodeCursor(cursor, cookbookContext(), 'cookbooks')).toEqual(keys);
+    });
+
+    it('refuses to mint a cursor from invalid comparison values', () => {
+        expect(() =>
+            encodeCursor({ sort: 'top', rating: Number.NaN, ratingCount: 0, id: 'r1' }, searchContext({ sort: 'top' })),
+        ).toThrow();
+    });
+});
+
+describe('decodeCursor rejections (400)', () => {
+    const context = searchContext({ sort: 'newest' });
+    const valid = encodeCursor({ sort: 'newest', createdAt: fixedDate, id: 'r1' }, context);
+
+    it.each([
+        ['not base64url JSON', '%%%not-a-cursor%%%'],
+        ['base64 of non-JSON', Buffer.from('hello', 'utf8').toString('base64url')],
+        ['JSON array', reencode([1, 2, 3])],
+        ['oversized', 'a'.repeat(5000)],
+        ['empty', ''],
+    ])('malformed: %s', (_label, raw) => {
+        expectBadCursor(() => decodeCursor(raw, context, 'newest'));
+    });
+
+    it.each([
+        ['wrong version', (p: Record<string, unknown>) => ({ ...p, version: 99 })],
+        ['missing scope hash', (p: Record<string, unknown>) => ({ ...p, scope: undefined })],
+        ['extra top-level field', (p: Record<string, unknown>) => ({ ...p, admin: true })],
+        [
+            'invalid date',
+            (p: Record<string, unknown>) => ({ ...p, keys: { sort: 'newest', createdAt: 'not-a-date', id: 'r1' } }),
+        ],
+        [
+            'empty id',
+            (p: Record<string, unknown>) => ({ ...p, keys: { sort: 'newest', createdAt: fixedDate, id: '' } }),
+        ],
+        ['missing id', (p: Record<string, unknown>) => ({ ...p, keys: { sort: 'newest', createdAt: fixedDate } })],
+        [
+            'sort of another kind',
+            (p: Record<string, unknown>) => ({ ...p, keys: { sort: 'top', rating: 1, ratingCount: 1, id: 'r1' } }),
+        ],
+    ])('tampered payload: %s', (_label, mutate) => {
+        expectBadCursor(() => decodeCursor(reencode(mutate(rawPayload(valid))), context, 'newest'));
+    });
+
+    it.each([
+        ['nonfinite score', { sort: 'relevance', score: 'Infinity', id: 'r1' }, 'relevance'],
+        ['string score', { sort: 'relevance', score: '0.5', id: 'r1' }, 'relevance'],
+        ['negative ratingCount', { sort: 'top', rating: 1, ratingCount: -1, id: 'r1' }, 'top'],
+        ['fractional ratingCount', { sort: 'top', rating: 1, ratingCount: 1.5, id: 'r1' }, 'top'],
+        ['invalid missing rank', { sort: 'time', missingRank: 2, totalMinutes: 10, id: 'r1' }, 'time'],
+        ['missing rank with a total', { sort: 'time', missingRank: 1, totalMinutes: 10, id: 'r1' }, 'time'],
+        ['complete rank without a total', { sort: 'time', missingRank: 0, totalMinutes: null, id: 'r1' }, 'time'],
+        ['negative total', { sort: 'time', missingRank: 0, totalMinutes: -3, id: 'r1' }, 'time'],
+    ] as const)('invalid comparison value: %s', (_label, keys, sort) => {
+        const ctx = searchContext({ sort });
+        // A genuine cursor for this context (so the scope matches) with only its values replaced.
+        const genuine = searchCases.find((c) => c.sort === sort)?.keys ?? searchCases[0].keys;
+        const payload = { ...rawPayload(encodeCursor(genuine, ctx)), keys };
+        expectBadCursor(() => decodeCursor(reencode(payload), ctx, sort));
+    });
+
+    it.each([
+        ['query', { q: 'soup' }],
+        ['sort', { sort: 'top' as const }],
+        ['mode', { mode: 'mine' as const }],
+        ['viewer', { viewerId: 'user_other' }],
+        ['anonymous viewer', { viewerId: null }],
+        ['cuisine filter', { cuisineId: 'c1' }],
+        ['course filter', { course: 'DINNER' }],
+        ['author filter', { authorId: 'user_owner' }],
+        ['onlyPublic', { isOnlyPublic: false }],
+        ['onlyUserRecipes', { isOnlyUserRecipes: true }],
+        ['fullMacros', { isFullMacros: true }],
+        ['diet', { diet: ['keto'] }],
+    ])('search context mismatch: %s', (_label, change) => {
+        const other = searchContext({ sort: 'newest', ...change });
+        expectBadCursor(() => decodeCursor(valid, other, other.sort));
+    });
+
+    it.each([
+        ['profile', { profileId: 'user_other' }],
+        ['viewer', { viewerId: 'user_other' }],
+        ['visibility scope', { scope: 'public' as const }],
+    ])('cookbook context mismatch: %s', (_label, change) => {
+        const cursor = encodeCursor({ sort: 'cookbooks', updatedAt: fixedDate, id: 'cb1' }, cookbookContext());
+        expectBadCursor(() => decodeCursor(cursor, cookbookContext(change), 'cookbooks'));
+    });
+
+    it('a search cursor is not a cookbook cursor (endpoint identity)', () => {
+        expectBadCursor(() => decodeCursor(valid, cookbookContext(), 'cookbooks'));
+    });
+});
+
+describe('buildCursorPage', () => {
+    const context = cookbookContext();
+    const rows = [
+        { id: 'c', updatedAt: fixedDate },
+        { id: 'b', updatedAt: fixedDate },
+        { id: 'a', updatedAt: fixedDate },
+    ];
+    const keyOf = (row: (typeof rows)[number]): CursorKeys => ({
+        sort: 'cookbooks',
+        updatedAt: row.updatedAt,
+        id: row.id,
+    });
+
+    it('trims the lookahead row and mints the cursor from the last returned row', () => {
+        const page = buildCursorPage(rows, 2, context, keyOf);
+        expect(page.items.map((r) => r.id)).toEqual(['c', 'b']);
+        expect(page.nextCursor).not.toBeNull();
+        expect(decodeCursor(page.nextCursor ?? '', context, 'cookbooks')).toEqual({
+            sort: 'cookbooks',
+            updatedAt: fixedDate,
+            id: 'b',
+        });
+    });
+
+    it('returns a null cursor when no further row exists', () => {
+        expect(buildCursorPage(rows, 3, context, keyOf)).toEqual({ items: rows, nextCursor: null });
+        expect(buildCursorPage([], 3, context, keyOf)).toEqual({ items: [], nextCursor: null });
+    });
+});
+
+describe('response helpers', () => {
+    it('apiCursor returns exactly { items, nextCursor }', async () => {
+        const res = apiCursor([{ id: 'a' }], 'next');
+        expect(res.status).toBe(200);
+        expect(await res.json()).toEqual({ items: [{ id: 'a' }], nextCursor: 'next' });
+        expect(await apiCursor([], null).json()).toEqual({ items: [], nextCursor: null });
+    });
+
+    it('apiPaginated keeps its { data, pagination } envelope', async () => {
+        const pagination = { page: 2, pageSize: 10, total: 11, hasNextPage: false };
+        expect(await apiPaginated([{ id: 'a' }], pagination).json()).toEqual({ data: [{ id: 'a' }], pagination });
+    });
+});
