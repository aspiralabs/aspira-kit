+// ---------------------------------------------------------------------------
+// IntersectionObserver double. Like the browser, observe() reports the current
+// intersection state once; setSentinelVisible() reports a change to every live
+// observer. Records keep the root each observer was created with.
+// ---------------------------------------------------------------------------
+type ObserverRecord = {
+    callback: IntersectionObserverCallback;
+    root: Element | Document | null;
+    targets: Set<Element>;
+    isConnected: boolean;
+    observer: FakeIntersectionObserver;
+};
+let observers: ObserverRecord[] = [];
+let isSentinelVisible = false;
+
+function entryFor(target: Element, isIntersecting: boolean): IntersectionObserverEntry {
+    const rect = target.getBoundingClientRect();
+    return {
+        boundingClientRect: rect,
+        intersectionRatio: isIntersecting ? 1 : 0,
+        intersectionRect: rect,
+        isIntersecting,
+        rootBounds: null,
+        target,
+        time: Date.now(),
+    };
+}
+
+function report(record: ObserverRecord, target: Element) {
+    if (!record.isConnected || !record.targets.has(target)) return;
+    record.callback([entryFor(target, isSentinelVisible)], record.observer);
+}
+
+class FakeIntersectionObserver {
+    readonly root: Element | Document | null;
+    readonly rootMargin = '0px';
+    readonly thresholds = [0];
+    private readonly record: ObserverRecord;
+
+    constructor(callback: IntersectionObserverCallback, options: IntersectionObserverInit = {}) {
+        this.root = options.root ?? null;
+        this.record = { callback, root: this.root, targets: new Set(), isConnected: true, observer: this };
+        observers.push(this.record);
+    }
+
+    observe(target: Element) {
+        this.record.targets.add(target);
+        this.record.isConnected = true;
+        queueMicrotask(() => report(this.record, target));
+    }
+
+    unobserve(target: Element) {
+        this.record.targets.delete(target);
+    }
+
+    disconnect() {
+        this.record.isConnected = false;
+        this.record.targets.clear();
+    }
+
+    takeRecords(): IntersectionObserverEntry[] {
+        return [];
+    }
+}
+
+async function setSentinelVisible(isVisible: boolean) {
+    isSentinelVisible = isVisible;
+    await act(async () => {
+        observers.forEach((record) => record.targets.forEach((target) => report(record, target)));
+    });
+}
+
+const liveObservers = () => observers.filter((record) => record.isConnected && record.targets.size > 0);
