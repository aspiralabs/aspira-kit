+  await screen.findByRole('header', { name: 'Add a recipe' });
+  if (tab === 'Explore') await fireEvent.press(screen.getByRole('tab', { name: 'Explore' }));
+  return utils;
+}
+
+type Query = Record<string, string>;
+
+const isExploreScreen = (q: Query) => q.onlyPublic === 'true' && q.authorId === undefined;
+const isProfile = (q: Query) => q.authorId === 'u2';
+const isPickerMine = (q: Query) => q.onlyUserRecipes === 'true';
+const isPickerExplore = (q: Query) => q.onlyPublic === 'true' && q.onlyUserRecipes === undefined;
+
+/** Fires the list's onEndReached from inside it (fireEvent walks up to the FlatList). */
+async function reachEnd(lastVisibleTitle: string) {
+  await fireEvent(screen.getByText(lastVisibleTitle), 'endReached');
+}
+
+/** Lets pending effects and promise callbacks run, so "no new request" checks are meaningful. */
+async function settle() {
+  await act(async () => {
+    await new Promise((resolve) => setTimeout(resolve, 20));
+  });
+}
+
+type Surface = {
+  name: string;
+  mount: () => Promise<unknown>;
+  match: (q: Query) => boolean;
+  /** Request params every page of this surface must carry. */
+  base: Query;
+};
+
+const SURFACES: Surface[] = [
+  { name: 'Explore', mount: () => mountExplore(), match: isExploreScreen, base: { paginated: '1', onlyPublic: 'true' } },
+  { name: 'user profile', mount: mountProfile, match: isProfile, base: { paginated: '1', authorId: 'u2' } },
+  {
+    name: 'picker My recipes tab',
+    mount: () => mountPicker('My recipes'),
+    match: isPickerMine,
+    base: { paginated: '1', onlyUserRecipes: 'true' },
+  },
+  {
+    name: 'picker Explore tab',
+    mount: () => mountPicker('Explore'),
+    match: isPickerExplore,
+    base: { paginated: '1', onlyPublic: 'true' },
+  },
+];
+
+describe.each(SURFACES)('explore-pagination spec § Mobile (F8/F9): $name pages /search', (surface) => {
+  it('appends later pages once, sends one request per end-reached while loading, and stops after the terminal page', async () => {
+    await surface.mount();
+    const first = await net.nthSearch(1, surface.match);
+    expect(first.query).toMatchObject(surface.base);
+    expect(first.query).not.toHaveProperty('cursor');
+    await act(async () => first.respond(pageOf(['Alpha One', 'Alpha Two'], 'c1')));
+    expect(await screen.findByText('Alpha Two')).toBeTruthy();
+    expect(screen.queryByText(NO_MORE)).toBeNull();
+
+    // Repeated end-reached while page two is in flight sends one request.
+    await reachEnd('Alpha Two');
+    await reachEnd('Alpha Two');
+    const second = await net.nthSearch(2, surface.match);
+    await settle();
+    expect(net.searches(surface.match)).toHaveLength(2);
+    expect(second.query).toMatchObject({ ...surface.base, cursor: 'c1' });
+
+    // A row that moved across the page boundary is shown once.
+    await act(async () =>
+      second.respond({ items: [row('id-Alpha Two', 'Alpha Two'), row('id-Alpha Three', 'Alpha Three')], nextCursor: 'c2' }),
+    );
+    expect(await screen.findByText('Alpha Three')).toBeTruthy();
+    expect(screen.getAllByText('Alpha Two')).toHaveLength(1);
+    expect(screen.getAllByText('Alpha One')).toHaveLength(1);
+    expect(screen.queryByText(NO_MORE)).toBeNull();
+
+    await reachEnd('Alpha Three');
+    const third = await net.nthSearch(3, surface.match);
+    expect(third.query).toMatchObject({ ...surface.base, cursor: 'c2' });
+    await act(async () => third.respond(pageOf(['Alpha Four'], null)));
+    expect(await screen.findByText('Alpha Four')).toBeTruthy();
+    expect(await screen.findByText(NO_MORE)).toBeTruthy();
+
+    // Exhausted: end-reached sends nothing more.
+    await reachEnd('Alpha Four');
+    await settle();
+    expect(net.searches(surface.match)).toHaveLength(3);
+  });
+
+  it('a failed first page offers retry instead of an empty state, and retry loads page one', async () => {
+    await surface.mount();
+    const first = await net.nthSearch(1, surface.match);
+    await act(async () => first.respond({ error: 'Search is down' }, 500));
+    expect(await screen.findByText("Couldn't load recipes")).toBeTruthy();
+    expect(screen.queryByText(EMPTY_TEXT)).toBeNull();
+    expect(screen.queryByText(NO_MORE)).toBeNull();
+
+    await fireEvent.press(screen.getByRole('button', { name: 'Try again' }));
+    const retry = await net.nthSearch(2, surface.match);
+    expect(retry.query).toMatchObject(surface.base);
+    expect(retry.query).not.toHaveProperty('cursor');
+    await act(async () => retry.respond(pageOf(['Beta One'], null)));
+    expect(await screen.findByText('Beta One')).toBeTruthy();
+    expect(screen.queryByText("Couldn't load recipes")).toBeNull();
+  });
+
+  it('a failed later page keeps the rows and offers retry; retry continues without duplicates', async () => {
+    await surface.mount();
+    const first = await net.nthSearch(1, surface.match);
+    await act(async () => first.respond(pageOf(['Gamma One', 'Gamma Two'], 'c1')));
+    await screen.findByText('Gamma Two');
+
+    await reachEnd('Gamma Two');
+    const second = await net.nthSearch(2, surface.match);
+    await act(async () => second.respond({ error: 'Timed out' }, 500));
+    const retryButton = await screen.findByRole('button', { name: 'Try again' });
+    expect(screen.getByText('Gamma One')).toBeTruthy();
+    expect(screen.getByText('Gamma Two')).toBeTruthy();
+    expect(screen.queryByText(NO_MORE)).toBeNull();
+
+    // A failed page is not retried by scrolling alone.
+    await reachEnd('Gamma Two');
+    await settle();
