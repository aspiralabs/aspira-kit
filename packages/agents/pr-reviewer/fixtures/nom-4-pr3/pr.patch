+} from '@playwright/test';
+import { type Course, type PrismaClient, type Role } from '@prisma/client';
+import { hashSync } from 'bcryptjs';
+import { PASSWORD } from '../config/test-data';
+import { contentToText, type PublicRecipeContent } from '../../lib/moderation/public-recipe';
+
+// Fixtures for the NOM-4 pagination specs (search-pagination.api.spec.ts and
+// search-pagination.spec.ts). Each spec run creates its own personas, recipes
+// and cookbooks under a per-run tag, so it never depends on (or disturbs) the
+// shared seed, and cleans them up afterwards. Recipes are written with Prisma
+// in the exact shape the app's moderation flow leaves them (decide.ts:
+// approveReview): a frozen snapshot whose searchText comes from the app's own
+// contentToText, pointed at by publishedSnapshotId. The search handler itself
+// is never mocked: every assertion reads the real route over HTTP.
+
+/** A short per-process tag; every fixture id and title carries it. */
+export const RUN = `${Date.now().toString(36)}${Math.floor(Math.random() * 1296).toString(36)}`;
+
+/** A random client IP: Better Auth rate-limits sign-in per x-forwarded-for. */
+export function randomClientIp(): string {
+    const octet = () => 1 + Math.floor(Math.random() * 253);
+    return `10.${octet()}.${octet()}.${octet()}`;
+}
+
+// -----------------------------------------------------------------------------
+// Personas
+// -----------------------------------------------------------------------------
+export interface Persona {
+    id: string;
+    email: string;
+    name: string;
+}
+
+/** Creates an org, a verified user and a credential account (same shape as e2e/seed.ts). */
+export async function createPersona(
+    prisma: PrismaClient,
+    key: string,
+    name: string,
+    role: Role = 'USER',
+): Promise<Persona> {
+    const id = `e2e_sp_${RUN}_${key}`;
+    const email = `sp-${RUN}-${key}@e2e.test`;
+    const orgId = `${id}_org`;
+    await prisma.organization.create({
+        data: { id: orgId, name: `${name} Org`, userCount: 1, userLimit: 1, organizationPlanLevel: 'FREE' },
+    });
+    await prisma.user.create({
+        data: {
+            id,
+            email,
+            name,
+            role,
+            emailVerified: true,
+            requiresSetup: false,
+            accountPlanLevel: 'FREE',
+            organizationId: orgId,
+            organizationRole: 'OWNER',
+        },
+    });
+    await prisma.account.create({
+        data: {
+            id: `${id}_acct`,
+            userId: id,
+            accountId: email,
+            providerId: 'credential',
+            password: hashSync(PASSWORD, 10),
+        },
+    });
+    return { id, email, name };
+}
+
+/** An API request context signed in as the persona through the real Better Auth endpoint. */
+export async function signIn(baseURL: string, persona: Persona): Promise<APIRequestContext> {
+    const ctx = await playwrightRequest.newContext({
+        baseURL,
+        extraHTTPHeaders: { 'x-forwarded-for': randomClientIp() },
+    });
+    const res = await ctx.post('/api/auth/sign-in/email', {
+        data: { email: persona.email, password: PASSWORD },
+        headers: { 'content-type': 'application/json' },
+    });
+    expect(res.ok(), `sign-in failed for ${persona.email}: ${res.status()} ${await res.text()}`).toBeTruthy();
+    return ctx;
+}
+
+// -----------------------------------------------------------------------------
+// Recipes
+// -----------------------------------------------------------------------------
+/** One ingredient line of a frozen snapshot: the line name, or only the linked catalog name. */
+export interface SnapshotLine {
+    name: string | null;
+    linkedName?: string;
+}
+
+/** The approved content a snapshot freezes. Missing fields copy the live recipe. */
+export interface SnapshotFixture {
+    title?: string;
+    prepTime?: number | null;
+    cookTime?: number | null;
+    lines?: SnapshotLine[];
+}
+
+export interface RecipeFixture {
+    key: string;
+    authorId: string;
+    title: string;
+    createdAt?: Date;
+    rating?: number;
+    ratingCount?: number;
+    prepTime?: number | null;
+    cookTime?: number | null;
+    course?: Course;
+    cuisineId?: string;
+    nutritionComplete?: boolean;
+    dietLabels?: string[];
+    /** Approved snapshot content; omit (or false) for a never-published recipe. */
+    published?: SnapshotFixture | false;
+    /** PUBLIC by default when published, PRIVATE otherwise. */
+    visibility?: 'PUBLIC' | 'PRIVATE';
+    moderationStatus?: 'NONE' | 'PENDING' | 'APPROVED';
+    takedownAt?: Date | null;
+}
+
+/** The fixture recipe id for a key (stable within a run). */
+export const recipeId = (key: string) => `e2e_sp_${RUN}_r_${key}`;
+
+// A type alias (not an interface) so it is both plain JSON for Prisma and a PublicRecipeContent.
+type SnapshotData = {
+    title: string;
+    image: null;
+    previewText: null;
+    description: null;
+    yield: number;
+    prepTime: number | null;
+    cookTime: number | null;
+    course: Course | null;
+    cuisineId: string | null;
+    tags: { id: string; name: string }[];
+    ingredientGroups: {
+        name: string;
+        order: number;
+        ingredients: {
+            name: string | null;
+            amount: number;
+            amountKind: string;
+            amountMax: null;
+            unit: null;
+            ingredient?: { name: string };
+        }[];
+    }[];
+    nutrition: null;
+    derivedLabels: null;
+};
+
+function snapshotContent(fixture: RecipeFixture, snapshot: SnapshotFixture): SnapshotData {
+    const lines = snapshot.lines ?? [];
+    return {
+        title: snapshot.title ?? fixture.title,
+        image: null,
+        previewText: null,
+        description: null,
+        yield: 2,
+        prepTime: snapshot.prepTime === undefined ? (fixture.prepTime ?? null) : snapshot.prepTime,
+        cookTime: snapshot.cookTime === undefined ? (fixture.cookTime ?? null) : snapshot.cookTime,
+        course: fixture.course ?? null,
+        cuisineId: fixture.cuisineId ?? null,
+        tags: [],
+        ingredientGroups: [
+            {
+                name: 'Main',
+                order: 1,
+                ingredients: lines.map((line) => ({
+                    name: line.name,
+                    amount: 1,
+                    amountKind: 'KNOWN',
+                    amountMax: null,
+                    unit: null,
+                    ...(line.linkedName ? { ingredient: { name: line.linkedName } } : {}),
+                })),
+            },
+        ],
+        nutrition: null,
+        derivedLabels: null,
+    };
+}
+
+/**
+ * Freezes `snapshot` as the recipe's current approved snapshot, the way
+ * approveReview publishes (a new snapshot row, then the pointer moves).
+ */
+export async function publishSnapshot(
+    prisma: PrismaClient,
+    fixture: RecipeFixture,
+    snapshot: SnapshotFixture,
+): Promise<void> {
+    const id = recipeId(fixture.key);
+    const data = snapshotContent(fixture, snapshot);
+    const content: PublicRecipeContent = data;
+    const row = await prisma.recipePublishedSnapshot.create({
+        data: { recipeId: id, data, searchText: contentToText(content), policyVersion: 'e2e' },
+    });
+    await prisma.recipe.update({ where: { id }, data: { publishedSnapshotId: row.id } });
+}
+
+export async function seedRecipe(prisma: PrismaClient, fixture: RecipeFixture): Promise<string> {
+    const id = recipeId(fixture.key);
+    const published = fixture.published ?? false;
+    await prisma.recipe.create({
+        data: {
+            id,
+            title: fixture.title,
+            authorId: fixture.authorId,
+            private: !published,
+            previewText: `${fixture.title} preview`,
+            yield: 2,
+            prepTime: fixture.prepTime ?? null,
+            cookTime: fixture.cookTime ?? null,
+            rating: fixture.rating ?? 0,
+            ratingCount: fixture.ratingCount ?? 0,
+            course: fixture.course ?? null,
+            cuisineId: fixture.cuisineId ?? null,
+            nutritionComplete: fixture.nutritionComplete ?? false,
+            dietLabels: fixture.dietLabels ?? [],
+            visibility: fixture.visibility ?? (published ? 'PUBLIC' : 'PRIVATE'),
+            moderationStatus: fixture.moderationStatus ?? (published ? 'APPROVED' : 'NONE'),
+            takedownAt: fixture.takedownAt ?? null,
+            ...(fixture.createdAt ? { createdAt: fixture.createdAt } : {}),
+        },
+    });
+    if (published) await publishSnapshot(prisma, fixture, published);
+    return id;
+}
+
+export async function seedRecipes(prisma: PrismaClient, fixtures: RecipeFixture[]): Promise<string[]> {
+    const ids: string[] = [];
+    for (const fixture of fixtures) ids.push(await seedRecipe(prisma, fixture));
+    return ids;
+}
+
+/** A creation time `minutesAgo` before a fixed base, so newest order is controlled. */
+export function minutesAgo(base: Date, minutes: number): Date {
+    return new Date(base.getTime() - minutes * 60_000);
+}
+
+/** Removes everything this run created (recipes first: Recipe.author does not cascade). */
+export async function cleanupRun(prisma: PrismaClient): Promise<void> {
+    const prefix = `e2e_sp_${RUN}_`;
+    const recipes = await prisma.recipe.findMany({ where: { id: { startsWith: prefix } }, select: { id: true } });
+    const ids = recipes.map((r) => r.id);
+    if (ids.length > 0) {
+        await prisma.meal.deleteMany({ where: { recipeId: { in: ids } } });
+        await prisma.recipe.updateMany({ where: { id: { in: ids } }, data: { publishedSnapshotId: null } });
+        await prisma.recipe.deleteMany({ where: { id: { in: ids } } });
+    }
+    await prisma.cuisine.deleteMany({ where: { id: { startsWith: prefix } } });
+    const users = await prisma.user.findMany({ where: { id: { startsWith: prefix } }, select: { id: true } });
+    const userIds = users.map((u) => u.id);
+    if (userIds.length > 0) {
+        await prisma.user.deleteMany({ where: { id: { in: userIds } } });
+        await prisma.organization.deleteMany({ where: { id: { in: userIds.map((u) => `${u}_org`) } } });
+    }
+}
+
+// -----------------------------------------------------------------------------
+// Search API
+// -----------------------------------------------------------------------------
+export interface SearchItem {
+    id: string;
+    title: string;
+    prepTime: number | null;
+    cookTime: number | null;
+    rating: number;
+}
+
+export interface SearchPage {
+    items: SearchItem[];
+    nextCursor: string | null;
+}
+
+function isRecord(value: unknown): value is Record<string, unknown> {
+    return typeof value === 'object' && value !== null && !Array.isArray(value);
+}
+
+function toSearchItem(value: unknown): SearchItem {
+    if (!isRecord(value) || typeof value.id !== 'string' || typeof value.title !== 'string') {
+        throw new Error(`not a search item: ${JSON.stringify(value)}`);
+    }
+    const minutes = (raw: unknown) => (typeof raw === 'number' ? raw : null);
+    return {
+        id: value.id,
+        title: value.title,
+        prepTime: minutes(value.prepTime),
+        cookTime: minutes(value.cookTime),
+        rating: typeof value.rating === 'number' ? value.rating : Number(value.rating),
+    };
+}
+
+/** Parses a `{ items, nextCursor }` page (throws on any other shape). */
+export function toSearchPage(body: unknown): SearchPage {
+    if (!isRecord(body) || !Array.isArray(body.items)) throw new Error(`not a cursor page: ${JSON.stringify(body)}`);
+    const next = body.nextCursor;
+    if (next !== null && typeof next !== 'string') throw new Error(`bad nextCursor: ${JSON.stringify(next)}`);
+    return { items: body.items.map(toSearchItem), nextCursor: next };
+}
+
+/** Parses a legacy bare-array response (throws on any other shape). */
+export function toSearchArray(body: unknown): SearchItem[] {
+    if (!Array.isArray(body)) throw new Error(`not a bare array: ${JSON.stringify(body)}`);
+    return body.map(toSearchItem);
+}
+
+export type Params = Record<string, string>;
+
+/** One opted-in page. */
+export async function searchPage(ctx: APIRequestContext, params: Params): Promise<SearchPage> {
+    const res = await ctx.get('/api/v1/search', { params: { paginated: '1', ...params } });
+    expect(res.status(), `GET /search ${JSON.stringify(params)}: ${await res.text()}`).toBe(200);
+    return toSearchPage(await res.json());
+}
+
+/** Follows nextCursor to the end; returns every page. */
+export async function traverse(
+    ctx: APIRequestContext,
+    params: Params,
+    maxPages = 50,
+): Promise<{ pages: SearchPage[]; items: SearchItem[] }> {
+    const pages: SearchPage[] = [];
+    let cursor: string | null = null;
+    do {
+        const page = await searchPage(ctx, cursor === null ? params : { ...params, cursor });
+        pages.push(page);
+        cursor = page.nextCursor;
+        if (pages.length > maxPages) throw new Error('traversal did not terminate');
+    } while (cursor !== null);
+    return { pages, items: pages.flatMap((p) => p.items) };
+}
+
+/** Whether a body is an `{ error }` payload (the API's 400 shape). */
+export function hasErrorMessage(body: unknown): boolean {
+    return isRecord(body) && typeof body.error === 'string' && body.error.length > 0;
+}
+
+// -----------------------------------------------------------------------------
+// Cookbooks and meal plans
+// -----------------------------------------------------------------------------
+export interface CookbookFixture {
+    key: string;
+    userId: string;
+    name: string;
+    isPrivate: boolean;
+    updatedAt: Date;
+}
+
+export const cookbookId = (key: string) => `e2e_sp_${RUN}_cb_${key}`;
+
+export async function seedCookbooks(prisma: PrismaClient, fixtures: CookbookFixture[]): Promise<void> {
+    for (const f of fixtures) {
+        await prisma.cookbook.create({
+            data: {
+                id: cookbookId(f.key),
+                userId: f.userId,
+                name: f.name,
+                isPrivate: f.isPrivate,
+                createdAt: f.updatedAt,
+                updatedAt: f.updatedAt,
+            },
+        });
+    }
+}
+
+/** A meal plan for the persona; meals cascade with it (and with the user). */
+export async function seedMealPlan(prisma: PrismaClient, userId: string, key: string): Promise<string> {
+    const id = `e2e_sp_${RUN}_mp_${key}`;
+    await prisma.mealPlan.create({ data: { id, userId, name: `E2E plan ${key}` } });
+    return id;
+}
+
+// -----------------------------------------------------------------------------
+// Browser helpers
+// -----------------------------------------------------------------------------
+/** A browser context signed in as the persona (or anonymous), with its own client IP. */
+export async function browserContext(
+    browser: Browser,
+    baseURL: string,
+    persona: Persona | null,
+    viewport: { width: number; height: number } = { width: 1280, height: 900 },
+): Promise<BrowserContext> {
+    const extraHTTPHeaders = { 'x-forwarded-for': randomClientIp() };
+    if (persona === null) return browser.newContext({ baseURL, extraHTTPHeaders, viewport });
+    const api = await signIn(baseURL, persona);
+    const storageState = await api.storageState();
+    await api.dispose();
+    return browser.newContext({ baseURL, extraHTTPHeaders, viewport, storageState });
+}
+
+/** Every /api/v1/search (or other matching API) request the page sends, in order. */
+export function recordRequests(page: Page, pathname: string): URL[] {
+    const seen: URL[] = [];
+    page.on('request', (req) => {
+        const url = new URL(req.url());
+        if (url.pathname === pathname) seen.push(url);
+    });
+    return seen;
+}
+
+export interface Hold {
+    /** Resolves once a matching request has been answered by the real server (and is being held). */
+    arrived: Promise<void>;
+    /** Delivers the held response to the page. */
+    release: () => void;
+}
+
+/**
+ * Holds the next request matching `match`: the real server answers it at once
+ * (so the body reflects the access state at request time), and the page only
+ * receives it after `release()`. Later matching requests pass through.
+ */
+export async function holdNext(page: Page, glob: string, match: (url: URL) => boolean): Promise<Hold> {
+    let release = () => {};
+    const gate = new Promise<void>((resolve) => {
+        release = resolve;
+    });
+    let arrivedResolve = () => {};
+    const arrived = new Promise<void>((resolve) => {
+        arrivedResolve = resolve;
+    });
+    let used = false;
+    await page.route(glob, async (route) => {
+        const url = new URL(route.request().url());
+        if (used || !match(url)) return route.fallback();
+        used = true;
+        const response = await route.fetch();
+        arrivedResolve();
+        await gate;
+        // The page may have aborted the request meanwhile; then there is nothing to deliver.
+        await route.fulfill({ response }).catch(() => undefined);
+    });
+    return { arrived, release };
+}
+
+/** Answers the next request matching `match` with a 500 (later ones pass through). */
+export async function failNext(
+    page: Page,
+    glob: string,
+    match: (url: URL) => boolean,
+): Promise<{ failed: () => boolean }> {
+    let used = false;
+    await page.route(glob, async (route) => {
+        const url = new URL(route.request().url());
+        if (used || !match(url)) return route.fallback();
+        used = true;
+        await route.fulfill({ status: 500, contentType: 'application/json', body: '{"error":"e2e injected failure"}' });
+    });
+    return { failed: () => used };
+}
+
+/** The hrefs of every rendered link whose href starts with `prefix`, in DOM order. */
+export async function hrefs(page: Page, prefix: string): Promise<string[]> {
+    return page.locator(`a[href^="${prefix}"]`).evaluateAll((els) => els.map((el) => el.getAttribute('href') ?? ''));
+}
+
+/**
+ * Scrolls `target` (the page when omitted) with the mouse wheel until `done`
+ * is visible, like a person reading to the end of the list.
+ */
+export async function scrollUntil(page: Page, done: Locator, target?: Locator, maxSteps = 60): Promise<void> {
+    for (let step = 0; step < maxSteps; step++) {
+        if (await done.isVisible()) return;
+        // Point the wheel at the scroll root (its centre), or the page.
+        const box = target ? await target.boundingBox() : null;
+        if (box) await page.mouse.move(box.x + box.width / 2, box.y + Math.min(box.height / 2, 300));
+        else await page.mouse.move(640, 450);
+        await page.mouse.wheel(0, 1500);
+        await page.waitForTimeout(250);
+    }
+    await expect(done).toBeVisible();
+}
+
+/** Fires the page's focus revalidation (document visibilitychange while visible). */
+export async function revalidateOnFocus(page: Page): Promise<void> {
+    await page.evaluate(() => document.dispatchEvent(new Event('visibilitychange', { bubbles: true })));
+}
