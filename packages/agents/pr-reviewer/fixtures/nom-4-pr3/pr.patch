+        server.use(http.get('*/api/v1/ping', () => HttpResponse.json({ ok: true })));
+        const result = z.object({ ok: z.boolean() }).parse(await fetcher('/api/v1/ping'));
+        expect(result.ok).toBe(true);
+    });
