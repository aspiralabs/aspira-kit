+// @vitest-environment jsdom
+// P20 (NOM-4 F10): a block or unblock drops every cursor list before the
+// broader revalidation, so no list keeps rows the new block state hides.
+// HTTP is answered by MSW; the kit Menu and the confirmation modal are doubles.
+import '@testing-library/jest-dom/vitest';
+import { QueryClient, QueryClientProvider } from '@tanstack/react-query';
+import { fireEvent, render, screen, waitFor } from '@testing-library/react';
+import { http, HttpResponse } from 'msw';
+import { beforeEach, describe, expect, it, vi } from 'vitest';
+
+import { ProfileActionsMenu } from './profile-actions-menu';
+import { server, startMswServer } from '@/tests/msw';
+
+startMswServer();
+
+const calls = vi.hoisted((): { order: string[] } => ({ order: [] }));
+
+vi.mock('@/lib/api/api-fetcher', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('@/lib/api/api-fetcher')>();
+    return {
+        ...actual,
+        resetCursorAccess: vi.fn(async (...args: Parameters<typeof actual.resetCursorAccess>) => {
+            calls.order.push('resetCursorAccess');
+            await actual.resetCursorAccess(...args);
+        }),
+    };
+});
+
+vi.mock('@aspiralabs/ui', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('@aspiralabs/ui')>();
+    return {
+        ...actual,
+        // The kit Menu needs pointer/layout APIs jsdom lacks; render each option as a button.
+        Menu: ({ options }: { options: Array<{ key: string; label: string; action?: () => void }> }) => (
+            <div>
+                {options.map((option) => (
+                    <actual.Button key={option.key} type="button" onClick={option.action}>
+                        {option.label}
+                    </actual.Button>
+                ))}
+            </div>
+        ),
+    };
+});
+
+type ConfirmProps = { onConfirm: (modal: { hide: () => void }) => Promise<void> };
+const modal = vi.hoisted((): { props: ConfirmProps | null } => ({ props: null }));
+vi.mock('@ebay/nice-modal-react', async (importOriginal) => {
+    const actual = await importOriginal<typeof import('@ebay/nice-modal-react')>();
+    return {
+        ...actual,
+        default: {
+            ...actual.default,
+            show: (_component: unknown, props: ConfirmProps) => {
+                modal.props = props;
+            },
+        },
+    };
+});
+
+vi.mock('@/components/providers/global-level-provider', () => ({
+    usePermission: () => ({ canAccess: () => true }),
+}));
+vi.mock('sonner', () => ({ toast: { success: vi.fn(), error: vi.fn() } }));
+
+let blockStatus = { isBlocking: false, isUnavailable: false };
+
+function renderMenu() {
+    const queryClient = new QueryClient({ defaultOptions: { queries: { retry: false } } });
+    const invalidate = queryClient.invalidateQueries.bind(queryClient);
+    vi.spyOn(queryClient, 'invalidateQueries').mockImplementation((...args) => {
+        calls.order.push('invalidateQueries');
+        return invalidate(...args);
+    });
+    render(
+        <QueryClientProvider client={queryClient}>
+            <ProfileActionsMenu profileId="user_2" profileName="Bea" />
+        </QueryClientProvider>,
+    );
+    return queryClient;
+}
+
+async function confirm(label: RegExp) {
+    fireEvent.click(await screen.findByRole('button', { name: label }));
+    const props = modal.props;
+    if (!props) throw new Error('The confirmation modal was not opened');
+    await props.onConfirm({ hide: vi.fn() });
+}
+
+beforeEach(() => {
+    calls.order = [];
+    modal.props = null;
+    blockStatus = { isBlocking: false, isUnavailable: false };
+    server.use(
+        http.get('*/api/v1/users/:id/block-status', () => HttpResponse.json(blockStatus)),
+        http.post('*/api/v1/users/:id/block', () => HttpResponse.json({ ok: true })),
+        http.delete('*/api/v1/users/:id/block', () => HttpResponse.json({ ok: true })),
+    );
+});
+
+describe('ProfileActionsMenu access reset (P20)', () => {
+    it('block: resets cursor access before revalidating block status', async () => {
+        renderMenu();
+        await confirm(/^Block$/);
+        await waitFor(() => expect(calls.order).toContain('invalidateQueries'));
+        expect(calls.order[0]).toBe('resetCursorAccess');
+        expect(calls.order.indexOf('resetCursorAccess')).toBeLessThan(calls.order.indexOf('invalidateQueries'));
+    });
+
+    it('unblock: resets cursor access before revalidating block status', async () => {
+        blockStatus = { isBlocking: true, isUnavailable: false };
+        renderMenu();
+        await confirm(/^Unblock$/);
+        await waitFor(() => expect(calls.order).toContain('invalidateQueries'));
+        expect(calls.order[0]).toBe('resetCursorAccess');
+    });
+
+    it('a failed block does not reset access', async () => {
+        server.use(http.post('*/api/v1/users/:id/block', () => HttpResponse.json({ error: 'nope' }, { status: 500 })));
+        renderMenu();
+        await confirm(/^Block$/);
+        expect(calls.order).toEqual([]);
+    });
+});
