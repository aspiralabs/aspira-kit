# Secrets live in the shared packages/agents/.env.local; this agent's .env.local is a symlink to it.
# pnpm analyze and eve load ../.env.local and .env.development.local.
AI_GATEWAY_API_KEY=
# Workhorse model for code fixes. No frontier model is needed.
STATIC_ANALYSIS_FIX_MODEL=openai/gpt-6-sol
# Loop caps (defaults shown).
STATIC_ANALYSIS_MAX_ROUNDS=6
STATIC_ANALYSIS_MAX_COST_USD=5
# Set to "fix" to also fix warning-severity diagnostics; default reports them only.
STATIC_ANALYSIS_WARNINGS=report
# Remote repositories: clone/push/PR credentials (read: public repos need none).
GITHUB_TOKEN=
# Commit identity for remote fixes.
STATIC_ANALYSIS_GIT_NAME=aspira-code-analyzer-agent
STATIC_ANALYSIS_GIT_EMAIL=noreply@aspiralabs.co
