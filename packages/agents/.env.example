# Shared secrets for every agent under packages/agents. Copy to .env.local; each
# agent's .env.local is a symlink to it, and eve loads it from the agent's folder.
# Per-agent overrides go in <agent>/.env.development.local, which eve loads with
# higher priority. Shell variables (DARREN_MODEL=... eve invoke) beat both.

# Vercel AI Gateway key. Every seat in every agent routes through the Gateway.
# https://vercel.com/<team>/~/ai-gateway/api-keys
AI_GATEWAY_API_KEY=

# GitHub token for private repos in load-repo / load-pr (optional).
GITHUB_TOKEN=

# Engineering guidelines in Notion, loaded into the sandbox by load-knowledge.
# NOTION_TOKEN: the API token of a Notion connection (Settings > Developer > Connections >
# New connection > API token). Then share the Engineering page with that connection.
# KNOWLEDGE_PAGE: the Engineering index page's URL or id. Leave both unset to run
# without guidelines; the agents say so in their reply.
# KNOWLEDGE_REQUIRED: comma-separated titles (or URLs) of the pages every agent must read
# in full before its first finding; load-knowledge concatenates them into REQUIRED.md and
# fails if one is not in the tree. Unset = "Agent Instructions, Review Verification";
# empty = none.
NOTION_TOKEN=
KNOWLEDGE_PAGE=
KNOWLEDGE_REQUIRED=

# spec-reviewer v2 (spec-audit). SEAT_MODEL: the one fast model the four audit seats
# (finn, nova, ava, bea) run on; default anthropic/claude-haiku-4.5. SEAT_REASONING: their
# reasoning effort (unset = provider default). SAM_VERIFY_REASONING: Sam's effort when
# verifying findings (default minimal). SEAT_RULES: JSON, seat name to the Review
# Verification headings it audits, e.g. {"nova":["Data flow completeness"]}; a heading not
# in REQUIRED.md fails the run before any seat runs.
SEAT_MODEL=
SEAT_REASONING=
SAM_VERIFY_REASONING=
SEAT_RULES=
