{
  "name": "@aspiralabs/static-analysis-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Detects a repository's static analyzers, runs them, auto-fixes, hands the rest to a workhorse model, and loops until clean.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "eve dev",
    "build": "eve info",
    "info": "eve info",
    "analyze": "node --env-file-if-exists=../.env.local --env-file-if-exists=.env.development.local --experimental-strip-types scripts/static-analysis.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint agent scripts"
  },
  "dependencies": {
    "ai": "^7.0.105",
    "eve": "^0.63.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@aspiralabs/config": "workspace:*",
    "@types/node": "^24",
    "eslint": "^9.39.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24"
  }
}
